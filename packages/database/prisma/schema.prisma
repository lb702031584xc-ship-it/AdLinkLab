// AdLinkLab Phase 1.1 — Database Foundation
// Money strategy: Decimal(19, 4) — never float
// Time strategy: all DateTime stored/interpreted as UTC (timestamptz)
// Deletion strategy: soft-delete via status + archivedAt/deletedAt; no cascade on attribution

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AccountStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DISABLED
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  REMOVED
}

enum AdGroupStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  REMOVED
}

enum AdStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  REMOVED
}

enum CriterionStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  REMOVED
}

enum OfferStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DRAFT
}

enum LandingPageStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DRAFT
}

enum TrackingLinkStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DRAFT
}

enum ConversionStatus {
  PENDING
  ATTRIBUTED
  UPLOADED
  FAILED
  ARCHIVED
}

enum GoogleUploadStatus {
  NOT_UPLOADED
  QUEUED
  UPLOADED
  FAILED
  SKIPPED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  ARCHIVED
}

enum UrlVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ROLLED_BACK
}

enum UrlChangeRequestStatus {
  DRAFT
  VALIDATED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum UrlEntityType {
  CUSTOMER
  CAMPAIGN
  AD_GROUP
  AD
  AD_GROUP_CRITERION
}

enum UserStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DISABLED
}

enum ScriptIntegrationStatus {
  ACTIVE
  DISABLED
  REVOKED
}

enum ScriptSyncState {
  SYNCED
  OUT_OF_SYNC
  NEVER_APPLIED
}

enum ScriptConnectionHealth {
  CONNECTED
  STALE
  DISABLED
}

enum ScriptExecutionResult {
  SUCCESS
  FAILED
  PARTIAL
  NO_CHANGE
}

/// Phase 2 Traffic Intelligence — traffic event journal event types.
/// Events are always observed data (dataQuality = OBSERVED) — never invented.
enum TrafficEventType {
  AD_CLICK
  LANDING_PAGE_VIEW
  AFFILIATE_CLICK
  MERCHANT_VISIT
  CONVERSION
  COMMISSION
}

// ---------------------------------------------------------------------------
// Tenant boundary
// ---------------------------------------------------------------------------

model Tenant {
  id         String     @id @db.Uuid
  name       String
  slug       String     @unique
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime?  @map("archived_at") @db.Timestamptz(3)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(3)

  users                 User[]
  googleAccounts        GoogleAccount[]
  offers                Offer[]
  orders                Order[]
  scriptIntegrations    GoogleAdsScriptIntegration[]
  /// Phase 1 Offer Intelligence back-references (additive)
  merchants             Merchant[]
  affiliateNetworks     AffiliateNetwork[]
  networkOfferPulls     NetworkOfferPull[]
  networkOffers         NetworkOffer[]
  offerPolicies         OfferPolicy[]
  policyEvidence        PolicyEvidence[]
  offerRiskScores       OfferRiskScore[]
  profitModels          ProfitModel[]
  /// Phase 2 Traffic Intelligence back-reference (additive)
  trafficEvents         TrafficEvent[]
  /// Phase 3 Optimization back-references (additive)
  experiments           Experiment[]
  killSwitchConfigs     KillSwitchConfig[]
  killSwitchEvents      KillSwitchEvent[]
  /// Phase 4 Research Lab back-references (additive)
  researchTests         ResearchTest[]
  researchResponses     ResearchResponse[]
  cloakingFindings      CloakingFinding[]
  landerAnalyses        LanderAnalysis[]
  competitorWatches     CompetitorWatch[]
  competitorChanges     CompetitorChange[]
  /// Automation — cashback offers + rotation groups (additive)
  cashbackOffers        CashbackOffer[]
  rotationGroups        RotationGroup[]
  /// Launch Wizard back-reference (additive)
  launchChecklists      LaunchChecklist[]
  cashbackRateChecks    CashbackRateCheck[]
  cashbackTermsWatches  CashbackTermsWatch[]
  redirectChainChecks   RedirectChainCheck[]
  cashbackCompareGroups CashbackCompareGroup[]
  cashbackRateSnapshots CashbackRateSnapshot[]
  /// Offer 最终链接指标（第三批，additive）
  offerMetrics          OfferMetrics[]
  /// 选品流水线运行记录（第五批，additive）
  productPipelineRuns   ProductPipelineRun[]
  offerCaptures         OfferCapture[]
  denylistEntries       DenylistEntry[]
  comboTestRuns         ComboTestRun[]
  asinWatches           AsinWatch[]
  asinSnapshots         AsinSnapshot[]
  onboardTasks          OnboardTask[]
  coachSetting          CoachSetting?
  manualSpend           ManualSpend?

  @@map("tenants")
}

model User {
  id           String     @id @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String
  name         String
  /// scrypt password hash (`scrypt$<saltHex>$<hashHex>`) — null for fixture/seed users
  passwordHash String?    @map("password_hash")
  /// 'admin' | 'member' | 'researcher' (Phase 4: researcher is API-isolated to /api/v1/research/*)
  role         String     @default("member") @map("role")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  googleAccounts GoogleAccount[]
  sessions       Session[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Opaque login sessions — only the SHA-256 hash of the token is stored.
model Session {
  id        String   @id @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Google Ads customer account. OAuth secrets are NEVER stored here —
/// only an opaque credential reference (vault/KMS key id).
model GoogleAccount {
  id                 String        @id @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  customerId         String        @map("customer_id")
  managerCustomerId  String?       @map("manager_customer_id")
  name               String
  currency           String
  timezone           String
  /// Opaque reference to encrypted OAuth credential storage (never plaintext secret)
  oauthCredentialRef String?       @map("oauth_credential_ref")
  status             AccountStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?     @map("archived_at") @db.Timestamptz(3)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(3)

  tenant             Tenant                       @relation(fields: [tenantId], references: [id])
  user               User                         @relation(fields: [userId], references: [id])
  campaigns          Campaign[]
  scriptIntegrations GoogleAdsScriptIntegration[]

  @@unique([customerId])
  @@index([tenantId])
  @@index([userId])
  @@map("google_accounts")
}

model Campaign {
  id               String         @id @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  googleAccountId  String         @map("google_account_id") @db.Uuid
  googleCampaignId String         @map("google_campaign_id")
  name             String
  status           CampaignStatus @default(ACTIVE)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?      @map("archived_at") @db.Timestamptz(3)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(3)

  /// Restrict — never cascade-delete attribution history
  googleAccount GoogleAccount  @relation(fields: [googleAccountId], references: [id], onDelete: Restrict)
  adGroups      AdGroup[]
  trackingLinks TrackingLink[]

  @@unique([googleAccountId, googleCampaignId])
  @@index([googleAccountId])
  @@index([tenantId])
  @@index([status])
  @@map("campaigns")
}

model AdGroup {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  campaignId      String        @map("campaign_id") @db.Uuid
  googleAdGroupId String        @map("google_ad_group_id")
  name            String
  status          AdGroupStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)

  campaign      Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  ads           Ad[]
  criteria      AdGroupCriterion[]
  trackingLinks TrackingLink[]

  @@unique([campaignId, googleAdGroupId])
  @@index([campaignId])
  @@index([tenantId])
  @@map("ad_groups")
}

model Ad {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  adGroupId  String    @map("ad_group_id") @db.Uuid
  googleAdId String    @map("google_ad_id")
  name       String
  status     AdStatus  @default(ACTIVE)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  adGroup       AdGroup        @relation(fields: [adGroupId], references: [id], onDelete: Restrict)
  trackingLinks TrackingLink[]

  @@unique([adGroupId, googleAdId])
  @@index([adGroupId])
  @@index([tenantId])
  @@map("ads")
}

model AdGroupCriterion {
  id                String          @id @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  adGroupId         String          @map("ad_group_id") @db.Uuid
  googleCriterionId String          @map("google_criterion_id")
  keyword           String?
  matchType         String?         @map("match_type")
  status            CriterionStatus @default(ACTIVE)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt        DateTime?       @map("archived_at") @db.Timestamptz(3)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)

  adGroup       AdGroup        @relation(fields: [adGroupId], references: [id], onDelete: Restrict)
  trackingLinks TrackingLink[]

  @@unique([adGroupId, googleCriterionId])
  @@index([adGroupId])
  @@index([tenantId])
  @@map("ad_group_criteria")
}

model Offer {
  id               String      @id @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  name             String
  network          String
  /// Offer 来源：affiliate（联盟）| amazon（亚马逊选品）| cashback（返利网）
  source           String      @default("affiliate") @map("source")
  destinationUrl   String      @map("destination_url")
  status           OfferStatus @default(ACTIVE)
  /// Lower number = higher priority (Phase 5)
  priority         Int         @default(100)
  startsAt         DateTime?   @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime?   @map("ends_at") @db.Timestamptz(3)
  idempotencyScope String?     @map("idempotency_scope")
  idempotencyKey   String?     @map("idempotency_key")
  /// Phase 1 Offer Intelligence — nullable additions only (additive)
  merchantId       String?     @map("merchant_id") @db.Uuid
  category         String?
  geoAllow         String[]    @map("geo_allow")
  cookieDays       Int?        @map("cookie_days")
  /// Money: Decimal(19,4) — never floating point
  commissionValue  Decimal?    @map("commission_value") @db.Decimal(19, 4)
  commissionType   String?     @map("commission_type")
  /// 产品平均价（用于盈利测算的 payout 推导）
  avgPrice         Decimal?    @map("avg_price") @db.Decimal(19, 4)
  /// 挑选日期（选品时记录，offer 多时作参考）
  pickedAt         DateTime?   @map("picked_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?   @map("archived_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  merchant           Merchant?           @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  landingPages       LandingPage[]
  trackingLinks      TrackingLink[]
  /// Launch Wizard back-reference (additive)
  launchChecklists   LaunchChecklist[]
  trackingLinkOffers TrackingLinkOffer[]
  offerPolicies      OfferPolicy[]
  offerRiskScores    OfferRiskScore[]
  /// Offer 最终链接指标（第三批，一对一）
  offerMetrics       OfferMetrics?
  profitModels       ProfitModel[]
  /// Phase 3 Optimization — A/B experiments + kill switch (additive, no existing behavior changed)
  experiments        Experiment[]
  killSwitchConfig   KillSwitchConfig?
  killSwitchEvents   KillSwitchEvent[]
  /// Phase 4 Research Lab — cloaking findings (additive, read-only from research)
  cloakingFindings   CloakingFinding[]

  @@unique([tenantId, idempotencyScope, idempotencyKey])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@map("offers")
}

/// Phase 5 — TrackingLink ↔ Offer bindings (priority / fallback)
model TrackingLinkOffer {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  trackingLinkId String   @map("tracking_link_id") @db.Uuid
  offerId        String   @map("offer_id") @db.Uuid
  /// Lower = higher priority
  priority       Int      @default(100)
  isFallback     Boolean  @default(false) @map("is_fallback")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  trackingLink TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Restrict)
  offer        Offer        @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@unique([tenantId, trackingLinkId, offerId])
  @@index([tenantId])
  @@index([trackingLinkId])
  @@index([offerId])
  @@map("tracking_link_offers")
}

model LandingPage {
  id          String            @id @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  offerId     String            @map("offer_id") @db.Uuid
  name        String
  url         String
  domain      String
  /// Lander Intel: rendered HTML when created from a template (nullable, additive).
  htmlContent String?           @map("html_content")
  status      LandingPageStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(3)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(3)

  offer            Offer             @relation(fields: [offerId], references: [id], onDelete: Restrict)
  trackingLinks    TrackingLink[]
  /// Launch Wizard back-reference (additive)
  launchChecklists LaunchChecklist[]

  @@index([offerId])
  @@index([domain])
  @@index([status])
  @@index([tenantId])
  @@map("landing_pages")
}

model TrackingLink {
  id            String             @id @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  publicId      String             @unique @map("public_id")
  campaignId    String?            @map("campaign_id") @db.Uuid
  adGroupId     String?            @map("ad_group_id") @db.Uuid
  adId          String?            @map("ad_id") @db.Uuid
  criterionId   String?            @map("criterion_id") @db.Uuid
  offerId       String             @map("offer_id") @db.Uuid
  landingPageId String?            @map("landing_page_id") @db.Uuid
  status        TrackingLinkStatus @default(ACTIVE)
  /// Health check: per-link interval in seconds (default 3600 = 1h), min 600 enforced in code
  healthCheckIntervalSec Int    @default(3600) @map("health_check_interval_sec")
  /// How this link was added: MANUAL (pasted by user) or AUTO (synced from network/offer)
  linkSource      String             @default("MANUAL") @map("link_source")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime?          @map("archived_at") @db.Timestamptz(3)
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz(3)

  campaign            Campaign?            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  adGroup             AdGroup?             @relation(fields: [adGroupId], references: [id], onDelete: Restrict)
  ad                  Ad?                  @relation(fields: [adId], references: [id], onDelete: Restrict)
  criterion           AdGroupCriterion?    @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  offer               Offer                @relation(fields: [offerId], references: [id], onDelete: Restrict)
  landingPage         LandingPage?         @relation(fields: [landingPageId], references: [id], onDelete: Restrict)
  clicks              Click[]
  trackingLinkOffers  TrackingLinkOffer[]
  alerts              Alert[]
  /// Health check history (per-link interval scheduling)
  healthChecks        LinkHealthCheck[]
  /// Automation — cashback offers bound to this tracking link (additive)
  cashbackOffers      CashbackOffer[]
  /// Launch Wizard back-reference (additive)
  launchChecklists    LaunchChecklist[]
  redirectChainChecks RedirectChainCheck[]

  @@index([campaignId])
  @@index([adGroupId])
  @@index([adId])
  @@index([criterionId])
  @@index([offerId])
  @@index([landingPageId])
  @@index([status])
  @@index([tenantId])
  @@map("tracking_links")
}

/// Event-level click storage. gclid is NOT globally unique — duplicates allowed.
/// Click.id is the public clickId used by Conversion/Order attribution.
model Click {
  id              String   @id @db.Uuid
  /// Mirrors id for explicit attribution APIs; unique within tenant writes
  clickId         String   @unique @map("click_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  trackingLinkId  String   @map("tracking_link_id") @db.Uuid
  offerId         String?  @map("offer_id") @db.Uuid
  landingPageId   String?  @map("landing_page_id") @db.Uuid
  campaignId      String?  @map("campaign_id") @db.Uuid
  adGroupId       String?  @map("ad_group_id") @db.Uuid
  adId            String?  @map("ad_id") @db.Uuid
  criterionId     String?  @map("criterion_id") @db.Uuid
  gclid           String?
  gbraid          String?
  wbraid          String?
  utmSource       String?  @map("utm_source")
  utmMedium       String?  @map("utm_medium")
  utmCampaign     String?  @map("utm_campaign")
  utmTerm         String?  @map("utm_term")
  utmContent      String?  @map("utm_content")
  userAgent       String?  @map("user_agent")
  ipAddress       String?  @map("ip_address")
  referer         String?
  country         String?
  region          String?
  city            String?
  deviceType      String?  @map("device_type")
  queryParameters Json?    @map("query_parameters")
  ingestionId     String?  @map("ingestion_id")
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Phase 2 — traffic attribution (additive). Only real observed values; never invented.
  trafficSource   String?  @map("traffic_source")
  trafficMedium   String?  @map("traffic_medium")
  /// Google Ads criterion match type (EXACT/PHRASE/BROAD) — real lookup only
  matchType       String?  @map("match_type")
  /// Automation: synthetic/test click marker (additive; existing rows default false)
  isTest          Boolean  @default(false) @map("is_test")

  /// Restrict — never cascade-delete clicks when tracking link archived
  trackingLink TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Restrict)
  conversions  Conversion[]
  orders       Order[]

  @@unique([tenantId, ingestionId])
  @@index([trackingLinkId])
  @@index([offerId])
  @@index([campaignId])
  @@index([gclid])
  @@index([createdAt])
  @@index([occurredAt])
  @@index([country])
  @@index([deviceType])
  @@index([tenantId])
  @@map("clicks")
}

model Conversion {
  id                           String             @id @db.Uuid
  tenantId                     String             @map("tenant_id") @db.Uuid
  clickId                      String             @map("click_id") @db.Uuid
  conversionAction             String             @map("conversion_action")
  conversionTime               DateTime           @map("conversion_time") @db.Timestamptz(3)
  /// Money: Decimal(19,4) — never floating point
  value                        Decimal?           @db.Decimal(19, 4)
  currency                     String?
  status                       ConversionStatus   @default(PENDING)
  googleUploadStatus           GoogleUploadStatus @default(NOT_UPLOADED) @map("google_upload_status")
  googleConversionResourceName String?            @map("google_conversion_resource_name")
  idempotencyScope             String?            @map("idempotency_scope")
  idempotencyKey               String?            @map("idempotency_key")
  createdAt                    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt                   DateTime?          @map("archived_at") @db.Timestamptz(3)
  deletedAt                    DateTime?          @map("deleted_at") @db.Timestamptz(3)

  click  Click   @relation(fields: [clickId], references: [id], onDelete: Restrict)
  orders Order[]

  @@unique([tenantId, idempotencyScope, idempotencyKey])
  @@index([clickId])
  @@index([conversionTime])
  @@index([status])
  @@index([googleUploadStatus])
  @@index([tenantId])
  @@map("conversions")
}

model Order {
  id               String      @id @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  clickId          String?     @map("click_id") @db.Uuid
  conversionId     String?     @map("conversion_id") @db.Uuid
  /// Business order id — unique per tenant (not global)
  orderId          String      @map("order_id")
  /// Money: Decimal(19,4)
  value            Decimal     @db.Decimal(19, 4)
  currency         String
  status           OrderStatus @default(PENDING)
  idempotencyScope String?     @map("idempotency_scope")
  idempotencyKey   String?     @map("idempotency_key")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?   @map("archived_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  click      Click?      @relation(fields: [clickId], references: [id], onDelete: Restrict)
  conversion Conversion? @relation(fields: [conversionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, orderId])
  @@unique([tenantId, idempotencyScope, idempotencyKey])
  @@index([clickId])
  @@index([conversionId])
  @@index([orderId])
  @@index([createdAt])
  @@index([tenantId])
  @@map("orders")
}

/// Append-only URL history. Content columns must never be UPDATEd after insert;
/// only status / effectiveAt may change via application rules.
model UrlVersion {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  entityType       UrlEntityType    @map("entity_type")
  entityId         String           @map("entity_id") @db.Uuid
  finalUrl         String           @map("final_url")
  finalMobileUrl   String?          @map("final_mobile_url")
  finalAppUrl      String?          @map("final_app_url")
  trackingTemplate String?          @map("tracking_template")
  /// Typed JSON map Record<string, string> — validated at API boundary
  customParameters Json             @default("{}") @map("custom_parameters")
  version          Int
  status           UrlVersionStatus @default(DRAFT)
  effectiveAt      DateTime?        @map("effective_at") @db.Timestamptz(3)
  createdBy        String?          @map("created_by")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Used only for status transitions — never rewrite URL content
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Version uniqueness is tenant-scoped (DB-enforced). Concurrent creates must retry on conflict.
  @@unique([tenantId, entityType, entityId, version])
  @@index([entityType, entityId])
  @@index([entityType, entityId, status])
  @@index([status])
  @@index([effectiveAt])
  @@index([tenantId])
  /// Partial unique ACTIVE: CREATE UNIQUE INDEX url_versions_one_active_per_entity
  /// ON url_versions (tenant_id, entity_type, entity_id) WHERE status = 'ACTIVE'
  /// (see migrations 20260909120000 / 20260909130000 — Prisma cannot express partial unique indexes)
  @@map("url_versions")
}

model UrlChangeRequest {
  id               String                 @id @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  entityType       UrlEntityType          @map("entity_type")
  entityId         String                 @map("entity_id") @db.Uuid
  fromVersionId    String?                @map("from_version_id") @db.Uuid
  toVersionId      String                 @map("to_version_id") @db.Uuid
  reason           String
  requestedBy      String                 @map("requested_by")
  status           UrlChangeRequestStatus @default(DRAFT)
  idempotencyScope String                 @default("URL_CHANGE") @map("idempotency_scope")
  idempotencyKey   String                 @map("idempotency_key")
  jobId            String?                @map("job_id")
  scheduledAt      DateTime?              @map("scheduled_at") @db.Timestamptz(3)
  executedAt       DateTime?              @map("executed_at") @db.Timestamptz(3)
  error            String?
  /// Automation: referral URL specified for this URL change (additive, nullable)
  referralUrl      String?                @map("referral_url")
  /// Automation: device targeting — "desktop" | "mobile" | "all" (additive, nullable)
  deviceTarget     String?                @map("device_target")
  /// Automation: target Google Ads account id (additive, nullable).
  /// Plain UUID with NO Prisma relation / FK constraint, following the polymorphic-id
  /// convention (e.g. AuditLog.entityId) — avoids breaking existing rows.
  googleAccountId  String?                @map("google_account_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, idempotencyScope, idempotencyKey])
  @@index([entityType, entityId])
  @@index([status])
  @@index([scheduledAt])
  @@index([jobId])
  @@index([tenantId])
  @@map("url_change_requests")
}

model SyncJob {
