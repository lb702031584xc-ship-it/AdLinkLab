  networkId    String   @map("network_id") @db.Uuid
  pulledAt     DateTime @default(now()) @map("pulled_at") @db.Timestamptz(3)
  offerCount   Int      @default(0) @map("offer_count")
  newCount     Int      @default(0) @map("new_count")
  updatedCount Int      @default(0) @map("updated_count")
  /// SUCCESS | FAILED
  status       String
  error        String?  @map("error") @db.Text

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  network AffiliateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@index([tenantId, networkId, pulledAt])
  @@map("network_offer_pulls")
}

/// Network API framework — raw offers pulled from a network adapter.
/// Staging table: Phase 1 auto-screening can promote rows into Offer later.
/// Money: Decimal(19,4) — never floating point.
model NetworkOffer {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  networkId  String   @map("network_id") @db.Uuid
  externalId String   @map("external_id")
  name       String
  payout     Decimal? @db.Decimal(19, 4)
  currency   String?  @default("USD")
  termsText  String?  @map("terms_text") @db.Text
  rawData    Json     @map("raw_data") @db.JsonB
