/// LP AI Rewriter (automation round 2): AI-generated before/after rewrite
/// drafts against analyzer issues; the user confirms in the UI before the
/// draft is applied to the LandingPage. Status is DRAFT/APPLIED (plain
/// String, not an enum, to keep the additive migration trivial).
model LandingPageRewrite {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  /// Nullable since task 4: template-sourced rewrite briefs have no source
  /// LandingPage yet (base HTML lives in rewritten_content.baseHtml).
  landingPageId    String?  @map("landing_page_id") @db.Uuid
  originalScore    Int      @map("original_score")
  issues           Json     @default("[]")
  rewrittenContent Json     @map("rewritten_content")
  newScore         Int?     @map("new_score")
  status           String   @default("DRAFT") @map("status")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, landingPageId])
  @@map("landing_page_rewrites")
}

enum OptimizationPriority {
  HIGH
  MEDIUM
  LOW
}

enum OptimizationTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

/// Launch Wizard (automation round 2): guided 6-step offer launch checklist.
/// Status is a plain String (DRAFT/IN_PROGRESS/COMPLETED) to keep the
/// additive migration trivial — same convention as LandingPageRewrite.
model LaunchChecklist {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  offerId        String?   @map("offer_id") @db.Uuid
  trackingLinkId String?   @map("tracking_link_id") @db.Uuid
  landingPageId  String?   @map("landing_page_id") @db.Uuid
  currentStep    Int       @default(1) @map("current_step")
  status         String    @default("DRAFT") @map("status")
  stepsData      Json      @default("{}") @map("steps_data")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  offer        Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  trackingLink TrackingLink? @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)
  landingPage  LandingPage?  @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([offerId])
  @@index([status])
  @@map("launch_checklists")
}

/// Automation round 2: weekly report — aggregated weekly stats + AI narrative
/// per tenant, generated every Monday 8am (America/New_York) by the
/// weekly-report worker, also manually triggerable via API.
model WeeklyReport {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  weekStart DateTime @map("week_start") @db.Timestamptz(3)
  weekEnd   DateTime @map("week_end") @db.Timestamptz(3)
  /// { spend, revenue, conversions, clicks, topOffers[], deadLinks,
  ///   newNegatives, newTasks, alerts } — spend is null when unavailable.
  data      Json     @db.JsonB
  aiSummary String   @map("ai_summary")
  /// GENERATED | SENT (plain String; email delivery not yet wired)
  status    String   @default("GENERATED")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, weekStart, weekEnd])
  @@index([tenantId])
  @@map("weekly_reports")
}

/// Offer 最终链接指标抓取 + 推荐指数（第三批）。
model OfferMetrics {
  id        String   @id @db.Uuid
  offerId   String   @unique @map("offer_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// 抓取到的指标 JSON（OfferMetrics 结构）。
  metrics   Json
  /// 推荐指数 0-100；无可用指标时为 null。
  score     Int?
  /// 等级：strong / good / caution / avoid。
  grade     String?
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("offer_metrics")
}

/// 选品流水线运行记录（第五批）：存每道门结果 JSON + 值得测试指数。
/// 否定清单（批次5追加）：用户维护的"别碰名单"，命中直接杀。
model DenylistEntry {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// asin | keyword | brand | category
  type      String   @db.VarChar(16)
  value     String   @db.VarChar(256)
  reason    String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type, value])
  @@index([tenantId])
  @@map("denylist_entries")
}

/// 组合测试（第九批）：一次测 5-10 个品的榜单页测试。
model ComboTestRun {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(200)
  /// 渲染好的榜单 HTML（复用 builtin-listicle 模板）
  htmlContent  String?  @map("html_content")
  /// [{asin,title,brand,price,rating,reviewCount,offerId,trackingLinkId,publicId,clickUrl}]
  items        Json
  testDays     Int      @default(3) @map("test_days")
  targetClicks Int      @default(200) @map("target_clicks")
  status       String   @default("running") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("combo_test_runs")
}

/// ASIN 跟踪（第十批）：用户一键跟踪的 ASIN。
/// 教练模式设置（第十三批）：每 tenant 一行；默认开启。
/// 手动录入累计花费（第十五批）：Campaign 模型无花费字段，花费走手动录入。
model ManualSpend {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  total     Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("manual_spend")
}

model CoachSetting {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  enabled          Boolean  @default(true)
  dailyBudgetLimit Float?   @map("daily_budget_limit")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("coach_settings")
}

model AsinWatch {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  asin      String   @db.VarChar(32)
  title     String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, asin])
  @@index([tenantId])
  @@map("asin_watches")
}

/// ASIN 快照（第十批）：每日快照 reviewCount/rating。
/// PA-API 实际返回无 BSR 字段（已查 amazon-adapter.ts：只有 CustomerReviews.Count/StarRating），
/// 用评论数增速做需求代理；原始响应当 JSON 存 rawJson。
model AsinSnapshot {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  asin        String   @db.VarChar(32)
  capturedAt  DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)
  reviewCount Int?     @map("review_count")
  rating      Float?
  price       Float?
  rawJson     Json?    @map("raw_json")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, asin, capturedAt])
  @@map("asin_snapshots")
}

/// 新手任务（第十二批）："7 天跑起来"任务流。
model OnboardTask {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  day       Int
  taskKey   String    @map("task_key") @db.VarChar(64)
  deepLink  String?   @map("deep_link") @db.VarChar(256)
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, taskKey])
  @@index([tenantId])
  @@map("onboard_tasks")
}

model ProductPipelineRun {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String?
  itemCount Int      @map("item_count")
  options   Json
  results   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("product_pipeline_runs")
}

model OfferCapture {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  url         String
  title       String?
  description String?
  price       Decimal? @db.Decimal
  currency    String?
  pageText    String   @map("page_text")
  pageHtml    String?  @map("page_html")
  /**
   * 是否带有插件发来的真实 HTML（列表接口用此列判断，不拉整页 HTML）。
   */
  hasHtml     Boolean  @default(false) @map("has_html")
  source      String   @default("extension")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)], map: "offer_captures_tenant_created_idx")
  @@map("offer_captures")
}

/// 投放档案：一次投放的完整档案——决策、条款、出价、文案、投后数据。
/// 确认广告计划后自动建档（draft），投后回填 impressions/clicks/spend 等。
model LaunchArchive {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  /// 库里 Offer id；手动 Offer 建档时为 null。
  offerId            String?   @map("offer_id") @db.Uuid
  offerName          String    @map("offer_name")
  network            String
  offerUrl           String?   @map("offer_url")
  decision           String?
  decisionReason     String?   @map("decision_reason")
  termsBrandBidding  String?   @map("terms_brand_bidding")
  termsDirectLinking String?   @map("terms_direct_linking")
  termsSummary       String?   @map("terms_summary")
  payout             Float?
  epc                Float?
  breakevenCpc       Float?    @map("breakeven_cpc")
  breakevenCvrPct    Float?    @map("breakeven_cvr_pct")
  recommendedBid     Float?    @map("recommended_bid")
  myBid              Float?    @map("my_bid")
  officialBid        Float?    @map("official_bid")
  dailyBudget        Float?    @map("daily_budget")
  budgetCurrency     String    @default("USD") @map("budget_currency")
  /// 关键词字符串数组。
  keywords           Json      @default("[]")
  /// RSA 文案 { headlines: string[], descriptions: string[] }。
  adCopy             Json      @default("{}")
  /// P1-4: testing phase { dailyBudget, totalBudget, expectedClicks, expectedConversions, durationDays }
  testingPhase       Json?     @map("testing_phase") @db.JsonB
  /// P1-4: scaling phase { triggerRoas, dailyBudget, maxDailyBudget }
  scalingPhase       Json?     @map("scaling_phase") @db.JsonB
  impressions        Int?
  clicks             Int?
  spend              Float?
  conversions        Int?
  revenue            Float?
  status             String    @default("draft")
  notes              String?
  launchedAt         DateTime? @map("launched_at") @db.Timestamptz(3)
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// 自动止损脚本最近生成时间（null = 未生成过）。脚本只在 Google Ads 内运行，站点不直接执行暂停。
  stopLossScriptAt   DateTime? @map("stop_loss_script_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  adPerfSnapshots AdPerfSnapshot[]

  @@index([tenantId, createdAt(sort: Desc)], map: "launch_archives_tenant_created_idx")
  @@index([tenantId, network], map: "launch_archives_tenant_network_idx")
  @@index([tenantId, status], map: "launch_archives_tenant_status_idx")
  @@map("launch_archives")
}

/// 投流数据人工回填快照（按档案 × 日期一条，同日重填 = 更新）：
/// Google Ads 无 API 直连、转化不在站内，真实投后数据靠人工回填。
/// 没回填就没有快照行——判断引擎只吃真实回填，绝不编造。
model AdPerfSnapshot {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  archiveId   String   @map("archive_id") @db.Uuid
  perfDate    DateTime @map("perf_date") @db.Date
  /// 实际花费（档案币种）。
  spend       Decimal  @db.Decimal(19, 4)
  /// 实际平均出价（CPC）；未回填 → null（未知，不参与低价判断）。
  avgCpc      Decimal? @map("avg_cpc") @db.Decimal(19, 4)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  archive LaunchArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@unique([archiveId, perfDate], name: "ad_perf_snapshots_archive_date_unique")
  @@index([tenantId, archiveId])
  @@map("ad_perf_snapshots")
}

/// P0-3 — DB-backed API keys (additive). Raw key material is NEVER stored:
/// only SHA-256 hash + display prefix. Env keys (ADLINKLAB_API_KEYS) keep
/// working alongside DB keys. Rotation: old row gets revokedAt=now +
/// graceExpiresAt=now+24h; validation accepts a revoked key only within grace.
model ApiKey {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String
  keyPrefix      String    @map("key_prefix")
  keyHash        String    @unique @map("key_hash")
  scopes         String[]  @default([])
  ipWhitelist    String[]  @default([]) @map("ip_whitelist")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  graceExpiresAt DateTime? @map("grace_expires_at") @db.Timestamptz(3)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  rotatedFromId  String?   @map("rotated_from_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rotatedFrom ApiKey?  @relation("ApiKeyRotation", fields: [rotatedFromId], references: [id])
  rotatedTo   ApiKey[] @relation("ApiKeyRotation")

  @@index([tenantId])
  @@map("api_keys")
}

/// P0-4 — IP bans for the own API only (never ad clicks). level: 'manual' |
/// 'auto'. revokedAt = manual unban. Auto bans are created by the error-rate
/// watcher (5min window, 4xx/5xx >= 100 -> 1h), with whitelist exemption.
model IpBan {
  id           String    @id @db.Uuid
  ip           String
  reason       String
  level        String    @default("auto")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  requestCount Int       @default(0) @map("request_count")
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ip])
  @@index([expiresAt])
  @@map("ip_bans")
}

/// P0-5 — Revoked session / JWT identifiers (Redis blacklist mirror).
/// Logout / password change / user ban writes here; auth middleware checks
/// jti (JWT) or token hash (opaque session) against this table + Redis.
model TokenRevocation {
  id        String   @id @db.Uuid
  jti       String?  @unique
  tokenHash String?  @unique @map("token_hash")
  type      String
  reason    String?
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("token_revocations")
}

/// P0-6 — Daily AI usage rollup per tenant. date is a calendar DATE (UTC).
model AiUsageDaily {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  date      DateTime @map("date") @db.Date
  tokensIn  Int      @default(0) @map("tokens_in")
  tokensOut Int      @default(0) @map("tokens_out")
  costCents Int      @default(0) @map("cost_cents")
  calls     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("ai_usage_daily")
}

/// P0-8 — Persistent error reports. 5xx writes immediately; messages must
/// already be redacted by the logger (never secrets / tokens / bodies).
model ErrorReport {
  id          String   @id @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  level       String
  message     String
  requestId   String?  @map("request_id")
  path        String?
  method      String?
  statusCode  Int?     @map("status_code")
  count       Int      @default(1)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([lastSeenAt])
  @@index([tenantId, lastSeenAt])
  @@map("error_reports")
}

/// P1-6: per-offer auto-status preferences (default OFF — suggestions only).
model OfferPreference {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  offerId          String   @map("offer_id") @db.Uuid
  autoStatusEnabled Boolean @default(false) @map("auto_status_enabled")
  zeroPerfDays     Int      @default(5) @map("zero_perf_days")
  roscDeclineDays  Int      @default(7) @map("rosc_decline_days")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([offerId])
  @@index([tenantId])
  @@map("offer_preferences")
}

/// P1-11: per-tenant attribution settings (defaults mirror K10/K9).
model AttributionSettings {
  id                                  String   @id @db.Uuid
  tenantId                            String   @map("tenant_id") @db.Uuid
  attributionWindowDays               Int      @default(30) @map("attribution_window_days")
  gclidDedupeMinutes                  Int      @default(30) @map("gclid_dedupe_minutes")
  duplicateClicksCountAsConversion    Boolean  @default(false) @map("duplicate_clicks_count_as_conversion")
  createdAt                           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId])
  @@map("attribution_settings")
}

/// P1-11: attribution conflicts — one order matching multiple offers; human resolves.
model AttributionConflict {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  mainOfferId     String?   @map("main_offer_id") @db.Uuid
  conflictOfferIds Json     @map("conflict_offer_ids") @db.JsonB
  reason          String?
  status          String    @default("open")
  resolvedOfferId String?   @map("resolved_offer_id") @db.Uuid
  resolvedBy      String?   @map("resolved_by") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@index([orderId])
  @@map("attribution_conflicts")
}

/// P1-17: generic idempotency keys (header Idempotency-Key; 24h expiry).
model IdempotencyKey {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  key        String
  scope      String
  targetId   String?  @map("target_id")
  response   Json?    @db.JsonB
  statusCode Int?     @map("status_code")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, key, scope])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// P1-18: AI prompts DB + versioning (code prompts.ts stays the default seed).
model AiPrompt {
  id          String   @id @db.Uuid
  key         String
  version     String
  model       String?
  temperature Float?
  content     String
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([key, version])
  @@index([key, isActive])
  @@map("ai_prompts")
}

/// P1-21: dead-letter jobs (failed queue work; retry/discard from /jobs).
model DeadLetterJob {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  jobName    String    @map("job_name")
  payload    Json?     @db.JsonB
  error      String?
  retryCount Int       @default(0) @map("retry_count")
  status     String    @default("queued")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@index([status])
  @@map("dead_letter_jobs")
}

/// §5: B-level capability grant applications (one capability per application).
model AdminGrantApplication {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  capability    String
  applicantId   String    @map("applicant_id") @db.Uuid
  purpose       String
  whitelist     Json      @default("[]") @db.JsonB
  requestedDays Int       @default(30) @map("requested_days")
  evidence      Json      @default("[]") @db.JsonB
  status        String    @default("pending")
  decisionNote  String?   @map("decision_note")
  decidedBy     String?   @map("decided_by") @db.Uuid
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("admin_grant_applications")
}

/// §5: active B-level grants (whitelist + limits + expiry; never a bypass).
model AdminGrant {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  capability    String
  applicationId String?  @map("application_id") @db.Uuid
  applicantId   String   @map("applicant_id") @db.Uuid
  approverId    String   @map("approver_id") @db.Uuid
  whitelist     Json     @default("[]") @db.JsonB
  usageLimit    Json     @default("{}") @db.JsonB
  usageCount    Int      @default(0) @map("usage_count")
  status        String   @default("active")
  startsAt      DateTime @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime @map("ends_at") @db.Timestamptz(3)
  revokedReason String?  @map("revoked_reason")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@index([status])
  @@map("admin_grants")
}

/// §5: grant audit log (append-only; never deletable by members).
model AdminGrantAudit {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  grantId   String?  @map("grant_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  detail    Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@index([grantId])
  @@map("admin_grant_audits")
}

/// 付费数据网关用量台账：每（租户 × 功能 × 日期 × key 来源）一行，calls 累加。
/// keySource：owner（站长直通）| tenant-own（租户自备 key）| platform（平台 key，另受 B 级授权 paid-data 的 usageLimit 约束）。
/// 只记次数，永不记凭证内容。
model PaidDataUsage {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// 功能键：keywords-expand | keywords-intent | keywords-ad-measure | catalog-ad-count | serp-ads | brand-bidding
  feature   String   @db.Text
  usageDate DateTime @map("usage_date") @db.Date
  keySource String   @map("key_source") @db.Text
  calls     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature, usageDate, keySource], name: "paid_data_usage_tenant_feature_date_source_unique")
  @@index([tenantId, usageDate])
  @@map("paid_data_usage")
}

/// 品牌落地页链接（品牌级投放落地页，如品牌旗舰店/官网首页链接）：
/// 按 租户 × 网络 × 品牌（brandKey = 归一化品牌名：trim + 小写 + 空白折叠）×
/// 国家（countryCode，空串 = 未指定）存一行；没有行 = 该品牌走单品投放
/// （中性状态，不是缺失——有些联盟品牌没有品牌级投放链接）。
/// promoMode 是投放方式的显式标注："brand"（有品牌级链接、走品牌页投放）|
/// "product"（没有品牌级链接、只能走单品）| null（未标注）——不能用
/// landingUrl 是否填写来冒充这个状态。
model BrandProfile {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  networkId   String   @map("network_id") @db.Uuid
  brandKey    String   @map("brand_key")
  countryCode String   @default("") @map("country_code")
  landingUrl  String   @map("landing_url")
  promoMode   String?  @map("promo_mode")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, networkId, brandKey, countryCode])
  @@map("brand_profiles")
}

/// 每租户系统设置（对标 autoads 系统设置）：key = ai | ads | proxies | system，
/// value 为 JSON 字符串；密钥类字段入库前 AES-256-GCM 加密。
model TenantSetting {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], name: "tenant_settings_tenant_key_unique")
  @@index([tenantId])
  @@map("tenant_settings")
}

/// 创意管理库：租户自有 RSA 文案资产（标题+描述）。手动建 / AI 入库 / 从投放档案导入。
enum CreativeStatus {
  DRAFT
  USED
  ARCHIVED
}

enum CreativeSource {
  MANUAL
  AI
  ARCHIVE
}

model Creative {
  id          String         @id @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  offerId     String?        @map("offer_id") @db.Uuid
  title       String
  description String
  finalUrl    String?        @map("final_url")
  angle       String?
  status      CreativeStatus @default(DRAFT)
  source      CreativeSource @default(MANUAL)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer  Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([offerId])
  @@map("creatives")
}
