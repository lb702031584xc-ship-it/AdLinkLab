}

/// Phase 1 Offer Intelligence — structured policy scan result (§5, additive).
model OfferPolicy {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  offerId           String    @map("offer_id") @db.Uuid
  sourceUrl         String?   @map("source_url")
  sourceSnapshotUrl String?   @map("source_snapshot_url")
  retrievedAt       DateTime? @map("retrieved_at") @db.Timestamptz(3)
  rawTerms          String?   @map("raw_terms")
  /// Record<rule name, "ALLOWED" | "FORBIDDEN" | "REQUIRED" | "UNKNOWN">
