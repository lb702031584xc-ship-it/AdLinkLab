/// Phase 8.4.1 — Google Ads Script Integration (desired-state config source for Scripts).
/// Token plaintext is NEVER stored — only keyId / prefix / hash.
model GoogleAdsScriptIntegration {
  id               String                  @id @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  googleAccountId  String                  @map("google_account_id") @db.Uuid
  name             String
  status           ScriptIntegrationStatus @default(ACTIVE)
  /// Opaque id for logs — never the raw token
  tokenKeyId       String                  @map("token_key_id")
  /// Short display prefix e.g. alk_s_ab12
  tokenPrefix      String                  @map("token_prefix")
  /// HMAC-SHA256 hash (pepper outside DB) — never plaintext
  tokenHash        String                  @unique @map("token_hash")
  /// Bumped when desired config for this integration changes
  configGeneration Int                     @default(0) @map("config_generation")
  lastSeenAt       DateTime?               @map("last_seen_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?               @map("archived_at") @db.Timestamptz(3)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(3)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  googleAccount GoogleAccount      @relation(fields: [googleAccountId], references: [id], onDelete: Restrict)
  targets       ScriptSyncTarget[]
  syncLogs      ScriptSyncLog[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([googleAccountId])
  @@map("google_ads_script_integrations")
}

/// Phase 8.4.1 — Sync target. entityId is polymorphic; AD-only enforced in Domain/Repository.
/// Ad (internal) is authority for Google IDs — denormalized fields are cache only.
model ScriptSyncTarget {
  id               String                 @id @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  integrationId    String                 @map("integration_id") @db.Uuid
  entityType       UrlEntityType          @map("entity_type")
  entityId         String                 @map("entity_id") @db.Uuid
  /// Denormalized from Ad.googleAdId — not authority
  googleAdId       String?                @map("google_ad_id")
  /// Denormalized AdLinkLab Campaign.id
  campaignId       String?                @map("campaign_id") @db.Uuid
  /// Denormalized AdLinkLab AdGroup.id
  adGroupId        String?                @map("ad_group_id") @db.Uuid
  desiredVersion   Int?                   @map("desired_version")
  appliedVersion   Int?                   @map("applied_version")
  lastSyncAt       DateTime?              @map("last_sync_at") @db.Timestamptz(3)
  lastSuccessAt    DateTime?              @map("last_success_at") @db.Timestamptz(3)
  syncState        ScriptSyncState        @default(NEVER_APPLIED) @map("sync_state")
  connectionHealth ScriptConnectionHealth @default(STALE) @map("connection_health")
  lastExecution    ScriptExecutionResult? @map("last_execution")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?              @map("archived_at") @db.Timestamptz(3)
  deletedAt        DateTime?              @map("deleted_at") @db.Timestamptz(3)

  integration GoogleAdsScriptIntegration @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  syncLogs    ScriptSyncLog[]

  @@unique([tenantId, integrationId, entityType, entityId])
  @@index([tenantId])
  @@index([integrationId])
  @@index([integrationId, entityType, entityId])
  @@map("script_sync_targets")
}

/// Phase 8.4.1 — Append-only Script sync history. Never cascade-delete.
model ScriptSyncLog {
  id                     String                @id @db.Uuid
  tenantId               String                @map("tenant_id") @db.Uuid
  integrationId          String                @map("integration_id") @db.Uuid
  targetId               String                @map("target_id") @db.Uuid
