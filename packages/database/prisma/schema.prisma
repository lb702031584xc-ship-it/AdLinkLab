  @@index([tenantId, merchantDomain, checkedAt(sort: Desc)])
  @@map("cashback_rate_snapshots")
}

/// Automation — offer rotation group (additive).
/// strategy: "round_robin" | "weighted" | ... (stored as plain string)
model RotationGroup {
