/// Phase 1 Offer Intelligence — affiliate network entity (additive).
/// API credentials are stored ONLY as an encrypted reference (apiKeyRef,
/// format `enc:v1:<...>`, AES-256-GCM) — never in plaintext.
model AffiliateNetwork {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  website       String?
  /// Adapter kind: "impact" | "rakuten" (see apps/api/src/networks/index.ts)
  kind          String    @default("impact")
  apiConfigured Boolean   @default(false) @map("api_configured")
  /// Encrypted API key reference (AccountSID:AuthToken for Impact).
  apiKeyRef     String?   @map("api_key_ref")
  /// Adapter-specific base URL override (e.g. Impact sandbox).
  apiBaseUrl    String?   @map("api_base_url")
  lastPullAt    DateTime? @map("last_pull_at") @db.Timestamptz(3)
  /// NEVER | RUNNING | SUCCESS | FAILED
  pullStatus    String    @default("NEVER") @map("pull_status")
  pullError     String?   @map("pull_error") @db.Text
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  merchants Merchant[]
  pulls     NetworkOfferPull[]
  offers    NetworkOffer[]

  @@index([tenantId])
  @@index([status])
  @@map("affiliate_networks")
}

/// Network API framework — one row per offer-pull run (audit + counts).
model NetworkOfferPull {
