  @@index([tenantId])
  @@index([cashbackOfferId])
  @@index([checkedAt])
  @@map("cashback_rate_checks")
}

/// Cashback automation pack (2026-10-08) — 商家返利条款监控。
model CashbackTermsWatch {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
