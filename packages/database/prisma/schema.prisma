/// Phase 1 Offer Intelligence — affiliate network entity (additive).
/// API credentials are stored ONLY as an encrypted reference (apiKeyRef,
/// format `enc:v1:<...>`, AES-256-GCM) — never in plaintext.
model AffiliateNetwork {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  website       String?
  /// Adapter kind: "impact" | "rakuten" (see apps/api/src/networks/index.ts)
  kind          String    @default("impact")
  apiConfigured Boolean   @default(false) @map("api_configured")
  /// Encrypted API key reference (AccountSID:AuthToken for Impact).
  apiKeyRef     String?   @map("api_key_ref")
  /// Adapter-specific base URL override (e.g. Impact sandbox).
  apiBaseUrl    String?   @map("api_base_url")
  lastPullAt    DateTime? @map("last_pull_at") @db.Timestamptz(3)
  /// NEVER | RUNNING | SUCCESS | FAILED
  pullStatus    String    @default("NEVER") @map("pull_status")
  pullError     String?   @map("pull_error") @db.Text
  /// P1-30 商品库双模式：官方 API / 登录态采集（'api' | 'session'，代码层校验）。
  syncMode      String    @default("api") @map("sync_mode")
  /// 加密后的 session Cookie（AES-256-GCM，复用 network-crypto；绝不记明文日志）。
  sessionRef    String?   @map("session_ref")
  /// NEVER | OK | EXPIRED | FAILED
  sessionStatus String    @default("NEVER") @map("session_status")
  sessionUpdatedAt DateTime? @map("session_updated_at") @db.Timestamptz(3)
  sessionError  String?   @map("session_error") @db.Text
  /// 可配置的 session 商品列表路径（默认由适配器提供；网络设置可覆盖）。
  sessionListPath String? @map("session_list_path")
  /// 官方 API 商品接口路径覆盖（如 YeahPromos Get Products；null → 适配器默认已验证路径）。
  apiProductsPath String? @map("api_products_path")
  /// SESSION_EXPIRED 连续次数；连续 3 次 → 自动进黑名单（network_account）。
  sessionExpireStrikes Int @default(0) @map("session_expire_strikes")
  /// session 模式登录用户名（明文可显示）。
  sessionUsername String? @map("session_username")
  /// session 模式登录密码（AES-256-GCM 加密，复用 network-crypto；绝不明文落库/日志/返回）。
  sessionPasswordRef String? @map("session_password_ref")
  /// 登录态有效期天数（null → 默认 30 天，可配）。
  sessionValidDays Int? @map("session_valid_days")
  /// 上次登录/刷新登录态的时间；sessionExpiresAt = lastLoginAt + sessionValidDays（计算得出，不存库）。
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  merchants Merchant[]
  pulls     NetworkOfferPull[]
  offers    NetworkOffer[]
  products  NetworkProduct[]
  syncJobs  CatalogSyncJob[]

  @@index([tenantId])
  @@index([status])
  @@map("affiliate_networks")
}

/// 商品库（catalog）：session/API 同步拉取的商品明细，供筛选建 Offer。
model NetworkProduct {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  networkId         String   @map("network_id") @db.Uuid
  /// 网络侧商品 ID（与 tenantId + networkId 联合去重）。
  externalId        String   @map("external_id")
  name              String
  brand             String?
  asin              String?
  price             Decimal? @db.Decimal(19, 4)
  commissionAmount  Decimal? @map("commission_amount") @db.Decimal(19, 4)
  commissionRate    Decimal? @map("commission_rate") @db.Decimal(9, 4)
  currency          String?  @default("USD")
  reviewCount       Int?     @map("review_count")
  recommended       Boolean  @default(false)
  recommendationScore Decimal? @map("recommendation_score") @db.Decimal(9, 2)
  /// 落地页类型：amazon_product（商品页）/ amazon_storefront（店铺页）/ dtc（品牌独立站）/ unknown。
  landingPageType String?  @map("landing_page_type") @db.Text
  /// 允许投放国家（PB country_code，如 US；多国家逗号分隔）。
  countryCode     String?  @map("country_code") @db.Text
  /// 商品状态：active（有效）/ inactive（手动下线）。默认 active。
  status          String   @default("active") @db.Text
  /// 广告投放数量（按品牌+国家查 Google SERP 付费广告数；null = 未计算）。
  adCount         Int?     @map("ad_count")
  /// 自投广告数（广告落地页域名含品牌名；Amazon 落地页分不清 → null）。
  adCountSelf     Int?     @map("ad_count_self")
  /// 他投广告数（联盟客/同行在投）。
  adCountOthers   Int?     @map("ad_count_others")
  /// 落首页/旗舰店的广告条数（落地页 URL 启发式分类，other 不计入；看同行用哪种打法）。
  adCountHome     Int?     @map("ad_count_home")
  /// 落商品页的广告条数（同上分类口径）。
  adCountProduct  Int?     @map("ad_count_product")
  /// 广告投放数量上次查询时间（14 天缓存期内跳过重查）。
  adCountCheckedAt DateTime? @map("ad_count_checked_at") @db.Timestamptz(3)
  /// 广告投放数量上一次计算值快照（重算时把旧 adCount/adCountCheckedAt 挪到这里，供趋势对比：新投/停投/持续；null = 还没重算过）。
  lastAdCount         Int?     @map("last_ad_count")
  lastAdCountCheckedAt DateTime? @map("last_ad_count_checked_at") @db.Timestamptz(3)
  promoUrl          String?  @map("promo_url")
  rawData           Json     @map("raw_data") @db.JsonB
  syncedAt          DateTime @map("synced_at") @db.Timestamptz(3)
  /// 连续同步出现期数（用于白名单自动建议：连续 3 期出现 → 生成 suggested 建议）。
  syncStreak        Int      @default(0) @map("sync_streak")
  /// 同步时按 brand + networkId 匹配到的 Merchant.id（匹配不上为 null）。
  merchantId        String?  @map("merchant_id") @db.Uuid
  /// 补强 #3：备选池阶段 inbox（同步入库）| pool（备选池）| testing（在测）| live（在投）。存量默认 inbox，不改变现有推荐/建 Offer 行为。
  poolStage         String   @default("inbox") @map("pool_stage")
  /// 补强 #4：offer 通过率（百分比数值；null = 未知，同步能拿到才写）。
  approvalRatePct   Decimal? @map("approval_rate_pct") @db.Decimal(5, 2)
  /// 补强 #4：返款/结算周期天数（null = 未知）。
  payoutCycleDays   Int?     @map("payout_cycle_days")
  /// 一键筛选最近结论：pass（全过）| kill（被某条规则杀）| review（数据不足待人工复核）；null = 未筛过。
  screenVerdict     String?  @map("screen_verdict") @db.Text
  /// 一键筛选结论原因（命中规则名 + 关键值）；pass 时为 null。
  screenReason      String?  @map("screen_reason") @db.Text
  /// 一键筛选最近运行时间。
  screenedAt        DateTime? @map("screened_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  network AffiliateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([tenantId, networkId, externalId])
  @@index([tenantId, networkId])
  @@index([tenantId, recommended])
  @@map("network_products")
}

/// 商品库同步后台任务（2026-10-20）：POST /catalog/sync 只建行 + 后台执行，
/// 前端轮询本表看阶段/结果，避免大批量同步阻塞 HTTP 请求。
/// status: queued | running | succeeded | failed | skipped（skipped = 黑名单账号/登录态过期等业务跳过，result 里有 skipReason）。
/// stage: 最近一次进度阶段（pulled / upserted / scored / offers / done）。
/// result: 同步 summary（CatalogSyncSummary）JSON；执行中为最近阶段的 partial。
model CatalogSyncJob {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  networkId  String    @map("network_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// 同步范围：full（全量）| brand（按商家）。
  scope      String    @default("full")
  /// 按商家同步时的 PB brand_id（scope=brand 时有值）。
  brandId    String?   @map("brand_id")
  status     String    @default("queued")
  stage      String?
  result     Json?     @db.JsonB
  error      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt  DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  network AffiliateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("catalog_sync_jobs")
}

/// 商品库筛选预设（每租户一条；autoCreateOffer 仅管理员可改）。
model CatalogScreeningPreset {
  id                  String   @id @db.Uuid
  tenantId            String   @unique @map("tenant_id") @db.Uuid
  minReviews          Int?     @map("min_reviews")
  minCommissionAmount Decimal? @map("min_commission_amount") @db.Decimal(19, 4)
  minCommissionRate   Decimal? @map("min_commission_rate") @db.Decimal(9, 4)
  minPrice            Decimal? @map("min_price") @db.Decimal(19, 4)
  maxPrice            Decimal? @map("max_price") @db.Decimal(19, 4)
  minScore            Int?     @map("min_score")
  autoCreateOffer     Boolean  @default(false) @map("auto_create_offer")
  autoCreateTopN      Int      @default(20) @map("auto_create_top_n")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("catalog_screening_presets")
}

/// 商品库黑名单：被封/下架/拒登的商家、账号、商品、Offer，同步与建 Offer 时自动跳过。
/// 黑名单不设自动过期（被封是事实）；删除为软删除（status="removed"），保留审计链；
/// 移除后进入观察期（observationUntil），观察期内中性对待（不拉黑、不加白）。
model CatalogBlacklist {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// 渠道：cashback | affiliate | amazon（三渠道各自独立）。
  channel         String    @default("affiliate")
  /// "merchant" | "network_account" | "product" | "offer"（后续可扩展 "domain"）。
  entityType      String    @map("entity_type")
  /// 商家 → Merchant.id；账号 → AffiliateNetwork.id；商品 → NetworkProduct.id；Offer → Offer.id。
  entityId        String    @map("entity_id")
  networkKind     String?   @map("network_kind")
  reason          String    @map("reason") @db.Text
  firstSeenAt     DateTime  @map("first_seen_at") @db.Timestamptz(3)
  lastConfirmedAt DateTime  @map("last_confirmed_at") @db.Timestamptz(3)
  /// "auto" | "manual"
  source          String
  createdBy       String?   @map("created_by") @db.Uuid
  /// 软删除：active | removed（同一实体只保留一条 active，复拉黑时旧行改回 active）。
  status          String    @default("active")
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(3)
  removedBy       String?   @map("removed_by") @db.Uuid
  removeReason    String?   @map("remove_reason") @db.Text
  observationUntil DateTime? @map("observation_until") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, entityType, entityId])
  @@index([tenantId, entityType])
  @@index([tenantId, channel, status])
  @@map("catalog_blacklist")
}

/// 商品库白名单（业务白名单，与 B6 审批白名单是两套，不要混）：
/// 手动管理为主；同步引擎对"连续 3 期正常出现"的商品只生成 suggested 建议，
/// 需用户确认后才转为 manual。
model CatalogWhitelist {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// 渠道：cashback | affiliate | amazon（三渠道各自独立）。
  channel     String    @default("affiliate")
  /// "merchant" | "network_account" | "product"
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  note        String?
  /// "manual" | "suggested"
  source      String
  suggestedAt DateTime? @map("suggested_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, entityType, entityId])
  @@map("catalog_whitelist")
}

/// 商家评估政策（每租户一条；阈值可调）。
model CatalogMerchantPolicy {
  id                String   @id @db.Uuid
  tenantId          String   @unique @map("tenant_id") @db.Uuid
  /// 扣量嫌疑阈值（百分比，如 30 = 30%）。
  shaveThresholdPct Decimal  @default(30) @map("shave_threshold_pct") @db.Decimal(5, 2)
  /// 扣量统计周期天数。
  shavePeriodDays   Int      @default(7) @map("shave_period_days")
  /// 连续超阈值的周期数（达到才进黑名单）。
  shavePeriods      Int      @default(3) @map("shave_periods")
  /// ROAS 评估窗口天数。
  roasDays          Int      @default(14) @map("roas_days")
  /// ROAS 阈值（commission/spend 低于此值 → unprofitable）。
  roasThreshold     Decimal  @default(0.9) @map("roas_threshold") @db.Decimal(5, 2)
  /// 订单超期未付款天数（PENDING 超过此天数 → non_payment）。
  nonPaymentDays    Int      @default(45) @map("non_payment_days")
  /// 黑名单移除后的观察期天数。
  observationDays   Int      @default(30) @map("observation_days")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("catalog_merchant_policies")
}

/// 商家周期信号（快照证据：自有转化 vs 网络订单、花费 vs 佣金并列存储）。
model CatalogMerchantSignal {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  merchantId        String    @map("merchant_id") @db.Uuid
  /// 渠道：cashback | affiliate | amazon。
  channel           String
  periodStart       DateTime  @map("period_start") @db.Timestamptz(3)
  periodDays        Int       @map("period_days")
  /// 本租户归因到该商家的转化数（Conversion ATTRIBUTED/UPLOADED，经 click→offer→merchant）。
  ownConversions    Int       @default(0) @map("own_conversions")
  /// 网络侧同步订单数（clickId/conversionId 为 null 的 Order；当前无写入链路 → 常为 0，记 insufficient_data）。
  networkOrders     Int       @default(0) @map("network_orders")
  /// 扣量率百分比 (own-network)/own*100；数据不足为 null。
  shavePct          Decimal?  @map("shave_pct") @db.Decimal(7, 2)
  adSpend           Decimal?  @map("ad_spend") @db.Decimal(19, 4)
  commission        Decimal?  @map("commission") @db.Decimal(19, 4)
  roas              Decimal?  @map("roas") @db.Decimal(9, 4)
  pendingOrders     Int       @default(0) @map("pending_orders")
  oldestPendingDays Int?      @map("oldest_pending_days")
  /// 证据备注（如 insufficient_data 原因）。
  note              String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, merchantId, channel, periodStart])
  @@index([tenantId, merchantId, channel])
  @@map("catalog_merchant_signals")
}

/// Network API framework — one row per offer-pull run (audit + counts).
model NetworkOfferPull {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  networkId    String   @map("network_id") @db.Uuid
  pulledAt     DateTime @default(now()) @map("pulled_at") @db.Timestamptz(3)
  offerCount   Int      @default(0) @map("offer_count")
  newCount     Int      @default(0) @map("new_count")
  updatedCount Int      @default(0) @map("updated_count")
  /// SUCCESS | FAILED
  status       String
  error        String?  @map("error") @db.Text

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  network AffiliateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@index([tenantId, networkId, pulledAt])
  @@map("network_offer_pulls")
}

/// Network API framework — raw offers pulled from a network adapter.
/// Staging table: Phase 1 auto-screening can promote rows into Offer later.
/// Money: Decimal(19,4) — never floating point.
model NetworkOffer {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  networkId  String   @map("network_id") @db.Uuid
  externalId String   @map("external_id")
  name       String
  payout     Decimal? @db.Decimal(19, 4)
  currency   String?  @default("USD")
  termsText  String?  @map("terms_text") @db.Text
  rawData    Json     @map("raw_data") @db.JsonB
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  network AffiliateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([tenantId, networkId, externalId])
  @@index([tenantId, networkId])
  @@map("network_offers")
}

/// Phase 1 Offer Intelligence — structured policy scan result (§5, additive).
model OfferPolicy {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  offerId           String    @map("offer_id") @db.Uuid
  sourceUrl         String?   @map("source_url")
  sourceSnapshotUrl String?   @map("source_snapshot_url")
  retrievedAt       DateTime? @map("retrieved_at") @db.Timestamptz(3)
  rawTerms          String?   @map("raw_terms")
  /// Record<rule name, "ALLOWED" | "FORBIDDEN" | "REQUIRED" | "UNKNOWN">
  rules             Json      @map("rules") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  offer    Offer            @relation(fields: [offerId], references: [id], onDelete: Restrict)
  evidence PolicyEvidence[]

  @@index([tenantId])
  @@index([offerId])
  @@map("offer_policies")
}

/// Phase 1 Offer Intelligence — per-rule evidence (§5, additive).
/// matchedText MUST come from the real fetched terms text — never invented by AI.
model PolicyEvidence {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  offerPolicyId String    @map("offer_policy_id") @db.Uuid
  rule          String
  matchedText   String    @map("matched_text")
  confidence    Float
  sourceExcerpt String?   @map("source_excerpt")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  offerPolicy OfferPolicy @relation(fields: [offerPolicyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([offerPolicyId])
  @@index([rule])
  @@map("policy_evidence")
}

/// Phase 1 Offer Intelligence — structured risk score snapshot (§6/§10, additive).
model OfferRiskScore {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  offerId       String    @map("offer_id") @db.Uuid
  overallScore  Float     @map("overall_score")
  policyScore   Float?    @map("policy_score")
  profitScore   Float?    @map("profit_score")
  merchantScore Float?    @map("merchant_score")
  trackingScore Float?    @map("tracking_score")
  /// RUN | TEST | MANUAL_REVIEW | DO_NOT_RUN
  decision      String
  evaluatedAt   DateTime  @default(now()) @map("evaluated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([offerId])
  @@index([decision])
  @@map("offer_risk_scores")
}

/// Phase 1 Offer Intelligence — profit model + three scenarios (§7/§8/§9/§35, additive).
model ProfitModel {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  offerId           String    @map("offer_id") @db.Uuid
  /// Money: Decimal(19,4) — never floating point
  commission        Decimal?  @db.Decimal(19, 4)
  commissionType    String?   @map("commission_type")
  currency          String    @default("USD")
  expectedCvr       Float?    @map("expected_cvr")
  approvalRate      Float?    @map("approval_rate")
  attributionRate   Float?    @map("attribution_rate")
  refundRate        Float?    @map("refund_rate")
  /// { worst: {...}, base: {...}, best: {...} } — each { cvr, cpc, clicks, profit }
  scenarios         Json      @map("scenarios") @db.JsonB
  breakEvenCpc      Float?    @map("break_even_cpc")
  recommendedMaxCpc Float?    @map("recommended_max_cpc")
  /// OBSERVED | PREDICTED | UNKNOWN — never let PREDICTED masquerade as OBSERVED
  dataQuality       String    @default("UNKNOWN") @map("data_quality")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([offerId])
  @@map("profit_models")
}

/// Phase 2 Traffic Intelligence — append-only traffic event journal (additive).
/// Chain: AD_CLICK → [LANDING_PAGE_VIEW] → AFFILIATE_CLICK → [MERCHANT_VISIT]
///        → CONVERSION → [COMMISSION]. Every row is observed data
/// (dataQuality is always OBSERVED) — never invented, never backfilled.
model TrafficEvent {
  id             String           @id @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  parentEventId  String?          @map("parent_event_id") @db.Uuid
  eventType      TrafficEventType @map("event_type")
  clickId        String?          @map("click_id") @db.Uuid
  conversionId   String?          @map("conversion_id") @db.Uuid
  trackingLinkId String?          @map("tracking_link_id") @db.Uuid
  timestamp      DateTime         @default(now()) @db.Timestamptz(3)
  source         String?
  destination    String?
  metadata       Json?            @db.JsonB
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  /// Restrict — never cascade-delete events when a parent event is removed
  parent   TrafficEvent?  @relation("TrafficEventChain", fields: [parentEventId], references: [id], onDelete: Restrict)
  children TrafficEvent[] @relation("TrafficEventChain")

  @@index([tenantId])
  @@index([clickId])
  @@index([conversionId])
  @@index([parentEventId])
  @@index([eventType])
  @@index([timestamp])
  @@map("traffic_events")
}

/// Phase 3 Optimization — A/B experiments (additive).
enum ExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  CANCELLED
}

/// Phase 3 Optimization — A/B experiment on one offer (additive).
model Experiment {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  offerId           String           @map("offer_id") @db.Uuid
  name              String
  status            ExperimentStatus @default(DRAFT)
  /// P1-12: LANDING_PAGE | DIRECT_LINK | AD_GROUP
  experimentType    String           @default("LANDING_PAGE") @map("experiment_type")
  seedAdGroupId     String?          @map("seed_ad_group_id")
  /// P1-12: graduation action none | pause_loser (pause via Script + manual confirmation)
  graduationAction  String           @default("none") @map("graduation_action")
  /// { type: "LANDING_PAGE"|"DIRECT_LINK", trackingLinkId: string, label: string }
  variantA          Json             @map("variant_a") @db.JsonB
  variantB          Json             @map("variant_b") @db.JsonB
  trafficSplitA     Int              @default(50) @map("traffic_split_a")
  splitSeed         String?          @map("split_seed")
  /// { clicks, ctr, cpc, lpViews, affiliateClicks, cvr, cpa, revenue, profit, approvalRate, refundRate }
  metricsA          Json?            @map("metrics_a") @db.JsonB
  metricsB          Json?            @map("metrics_b") @db.JsonB
  winner            String?
  confidence        Float?
  preconditionCheck Json?            @map("precondition_check") @db.JsonB
  startedAt         DateTime?        @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime?        @map("ended_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([offerId])
  @@map("experiments")
}

/// Phase 3 Optimization — per-offer kill-switch thresholds (additive).
/// enabled=false (default): alert only, never auto-pause (prevents friendly fire).
model KillSwitchConfig {
  id                        String   @id @db.Uuid
  tenantId                  String   @map("tenant_id") @db.Uuid
  offerId                   String   @map("offer_id") @db.Uuid
  enabled                   Boolean  @default(false)
  /// Money: Decimal(12,2)
  maxSpend                  Decimal? @map("max_spend") @db.Decimal(12, 2)
  minExpectedProfit         Decimal? @map("min_expected_profit") @db.Decimal(12, 2)
  minCvr                    Float?   @map("min_cvr")
  maxPolicyRisk             Int?     @map("max_policy_risk")
  /// 测试止损（第七批）：花费上限；X 花费零转化
  testSpendCap              Decimal? @map("test_spend_cap") @db.Decimal(12, 2)
  testZeroConvSpend         Decimal? @map("test_zero_conv_spend") @db.Decimal(12, 2)
  pauseOnMerchantTerminated Boolean  @default(true) @map("pause_on_merchant_terminated")
  /// P0-10：触发时是否同时下发 Google Ads campaign-toggle PAUSE 任务（默认 false，需二次确认）
  pauseGoogleAdsToo         Boolean  @default(false) @map("pause_google_ads_too")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId])
  @@index([tenantId])
  @@map("kill_switch_configs")
}

/// Phase 3 Optimization — kill-switch firing record (append-only, additive).
model KillSwitchEvent {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  offerId           String   @map("offer_id") @db.Uuid
  /// SPEND_PROFIT | CVR_FLOOR | POLICY_RISK | MERCHANT_TERMINATED
  triggeredBy       String   @map("triggered_by")
  conditionSnapshot Json     @map("condition_snapshot") @db.JsonB
  /// ALERT_ONLY | PAUSED_ALL_LINKS
  actionTaken       String   @map("action_taken")
  linksPaused       Int      @default(0) @map("links_paused")
  /// P0-10 审计：是否同时下发了 Google Ads 暂停任务 + 任务 ID
  googleAdsPaused   Boolean  @default(false) @map("google_ads_paused")
  googleAdsTaskId   String?  @map("google_ads_task_id")
  autoExecute       Boolean  @map("auto_execute")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([offerId])
  @@map("kill_switch_events")
}

/// Phase 4 Research Lab — cloaking/differential research test (additive).
/// A test fetches targetUrl with several request variants (UA / language /
/// geo-flavoured) and compares the responses for cloaking signals.
model ResearchTest {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  targetUrl String    @map("target_url")
  name      String
  /// PENDING | RUNNING | COMPLETED | FAILED
  status    String    @default("PENDING")
  /// Request variant configs: [{ name, userAgent, acceptLanguage, headers? }]
  variants  Json      @db.JsonB
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  responses ResearchResponse[]
  findings  CloakingFinding[]

  @@index([tenantId])
  @@index([status])
  @@map("research_tests")
}

/// Phase 4 Research Lab — one fetched response per request variant (additive).
/// Failed variants record their error in meta (never throw); they are excluded
/// from differential comparison.
model ResearchResponse {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  researchTestId String    @map("research_test_id") @db.Uuid
  variantName    String    @map("variant_name")
  httpStatus     Int?      @map("http_status")
  finalUrl       String?   @map("final_url")
  redirectChain  Json      @default("[]") @map("redirect_chain") @db.JsonB
  headers        Json      @default("{}") @db.JsonB
  htmlHash       String?   @map("html_hash")
  contentHash    String?   @map("content_hash")
  textExcerpt    String?   @map("text_excerpt")
  /// { error?: string, setCookieCount?: number, ... } — failure detail lives here
  meta           Json      @default("{}") @db.JsonB
  linksCount     Int?      @map("links_count")
  scriptsCount   Int?      @map("scripts_count")
  fetchedAt      DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  test   ResearchTest @relation(fields: [researchTestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([researchTestId])
  @@map("research_responses")
}

/// Phase 4 Research Lab — differential/cloaking finding per test run (additive).
/// differentialScore is a heuristic 0-100; 差异≠恶意 — see classifier.ts.
model CloakingFinding {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  researchTestId    String    @map("research_test_id") @db.Uuid
  offerId           String?   @map("offer_id") @db.Uuid
  /// Weighted differential score, 0-100 (see research/detector.ts)
  differentialScore Float     @map("differential_score")
  /// NORMAL | MINOR | SUSPICIOUS | HIGH_RISK | STRONG (score bands, §21)
  band              String
  /// One of the 8 classifier labels (see research/classifier.ts, §22)
  classification    String
  evidence          Json      @db.JsonB
  aiSummary         String?   @map("ai_summary")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  test   ResearchTest @relation(fields: [researchTestId], references: [id], onDelete: Cascade)
  offer  Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([researchTestId])
  @@index([offerId])
  @@map("cloaking_findings")
}

/// Lander Intel — landing page efficiency analysis (additive).
/// scores: { performance, cta, trust, mobile, copy, bounceRisk } 0-100 each.
/// issues: [{ dimension, severity: "high"|"medium"|"low", message }].
/// suggestions: [{ text, dataQuality: "PREDICTED" }] — always AI-generated.
model LanderAnalysis {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  url          String
  domain       String
  overallScore Float     @map("overall_score")
  scores       Json      @db.JsonB
  issues       Json      @db.JsonB
  suggestions  Json      @db.JsonB
  analyzedAt   DateTime  @default(now()) @map("analyzed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("lander_analyses")
}

/// Lander Intel — competitor landing page watch (additive).
/// checkInterval in seconds, minimum 3600 (1h) enforced in code.
model CompetitorWatch {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  url           String
  checkInterval Int       @default(3600) @map("check_interval")
  lastHash      String?   @map("last_hash")
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  changes CompetitorChange[]

  @@index([tenantId])
  @@map("competitor_watches")
}

/// Lander Intel — detected competitor page change (additive).
/// diffSummary: { title?: {before, after}, price?: {before, after},
///   cta?: {before, after}, sectionsAdded?: string[], sectionsRemoved?: string[] }
model CompetitorChange {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  watchId     String   @map("watch_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  diffSummary Json     @map("diff_summary") @db.JsonB

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  watch  CompetitorWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([watchId])
  @@map("competitor_changes")
}

/// Lander Intel — high-converting landing page templates (additive).
/// category: review | comparison | listicle | quiz.
/// tenantId NULL => built-in global template.
model LanderTemplate {
  id           String    @id @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
