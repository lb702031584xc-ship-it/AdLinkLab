/// Phase 1 Offer Intelligence — profit model + three scenarios (§7/§8/§9/§35, additive).
model ProfitModel {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  offerId           String    @map("offer_id") @db.Uuid
  /// Money: Decimal(19,4) — never floating point
  commission        Decimal?  @db.Decimal(19, 4)
  commissionType    String?   @map("commission_type")
  currency          String    @default("USD")
  expectedCvr       Float?    @map("expected_cvr")
  approvalRate      Float?    @map("approval_rate")
  attributionRate   Float?    @map("attribution_rate")
  refundRate        Float?    @map("refund_rate")
  /// { worst: {...}, base: {...}, best: {...} } — each { cvr, cpc, clicks, profit }
  scenarios         Json      @map("scenarios") @db.JsonB
  breakEvenCpc      Float?    @map("break_even_cpc")
  recommendedMaxCpc Float?    @map("recommended_max_cpc")
  /// OBSERVED | PREDICTED | UNKNOWN — never let PREDICTED masquerade as OBSERVED
  dataQuality       String    @default("UNKNOWN") @map("data_quality")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([offerId])
  @@map("profit_models")
}

/// Phase 2 Traffic Intelligence — append-only traffic event journal (additive).
/// Chain: AD_CLICK → [LANDING_PAGE_VIEW] → AFFILIATE_CLICK → [MERCHANT_VISIT]
///        → CONVERSION → [COMMISSION]. Every row is observed data
/// (dataQuality is always OBSERVED) — never invented, never backfilled.
model TrafficEvent {
  id             String           @id @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  parentEventId  String?          @map("parent_event_id") @db.Uuid
  eventType      TrafficEventType @map("event_type")
  clickId        String?          @map("click_id") @db.Uuid
  conversionId   String?          @map("conversion_id") @db.Uuid
  trackingLinkId String?          @map("tracking_link_id") @db.Uuid
  timestamp      DateTime         @default(now()) @db.Timestamptz(3)
  source         String?
  destination    String?
  metadata       Json?            @db.JsonB
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  /// Restrict — never cascade-delete events when a parent event is removed
  parent   TrafficEvent?  @relation("TrafficEventChain", fields: [parentEventId], references: [id], onDelete: Restrict)
  children TrafficEvent[] @relation("TrafficEventChain")

  @@index([tenantId])
  @@index([clickId])
  @@index([conversionId])
  @@index([parentEventId])
  @@index([eventType])
  @@index([timestamp])
  @@map("traffic_events")
}

/// Phase 3 Optimization — A/B experiments (additive).
enum ExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  CANCELLED
}

/// Phase 3 Optimization — A/B experiment on one offer (additive).
model Experiment {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  offerId           String           @map("offer_id") @db.Uuid
  name              String
  status            ExperimentStatus @default(DRAFT)
  /// { type: "LANDING_PAGE"|"DIRECT_LINK", trackingLinkId: string, label: string }
  variantA          Json             @map("variant_a") @db.JsonB
  variantB          Json             @map("variant_b") @db.JsonB
  trafficSplitA     Int              @default(50) @map("traffic_split_a")
  splitSeed         String?          @map("split_seed")
  /// { clicks, ctr, cpc, lpViews, affiliateClicks, cvr, cpa, revenue, profit, approvalRate, refundRate }
  metricsA          Json?            @map("metrics_a") @db.JsonB
  metricsB          Json?            @map("metrics_b") @db.JsonB
  winner            String?
  confidence        Float?
  preconditionCheck Json?            @map("precondition_check") @db.JsonB
  startedAt         DateTime?        @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime?        @map("ended_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([offerId])
  @@map("experiments")
}

/// Phase 3 Optimization — per-offer kill-switch thresholds (additive).
/// enabled=false (default): alert only, never auto-pause (prevents friendly fire).
model KillSwitchConfig {
  id                        String   @id @db.Uuid
  tenantId                  String   @map("tenant_id") @db.Uuid
  offerId                   String   @map("offer_id") @db.Uuid
  enabled                   Boolean  @default(false)
  /// Money: Decimal(12,2)
  maxSpend                  Decimal? @map("max_spend") @db.Decimal(12, 2)
  minExpectedProfit         Decimal? @map("min_expected_profit") @db.Decimal(12, 2)
  minCvr                    Float?   @map("min_cvr")
  maxPolicyRisk             Int?     @map("max_policy_risk")
  /// 测试止损（第七批）：花费上限；X 花费零转化
  testSpendCap              Decimal? @map("test_spend_cap") @db.Decimal(12, 2)
  testZeroConvSpend         Decimal? @map("test_zero_conv_spend") @db.Decimal(12, 2)
  pauseOnMerchantTerminated Boolean  @default(true) @map("pause_on_merchant_terminated")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId])
  @@index([tenantId])
  @@map("kill_switch_configs")
}

/// Phase 3 Optimization — kill-switch firing record (append-only, additive).
model KillSwitchEvent {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  offerId           String   @map("offer_id") @db.Uuid
  /// SPEND_PROFIT | CVR_FLOOR | POLICY_RISK | MERCHANT_TERMINATED
  triggeredBy       String   @map("triggered_by")
  conditionSnapshot Json     @map("condition_snapshot") @db.JsonB
  /// ALERT_ONLY | PAUSED_ALL_LINKS
  actionTaken       String   @map("action_taken")
  linksPaused       Int      @default(0) @map("links_paused")
  autoExecute       Boolean  @map("auto_execute")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([offerId])
  @@map("kill_switch_events")
}

/// Phase 4 Research Lab — cloaking/differential research test (additive).
/// A test fetches targetUrl with several request variants (UA / language /
/// geo-flavoured) and compares the responses for cloaking signals.
model ResearchTest {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  targetUrl String    @map("target_url")
  name      String
  /// PENDING | RUNNING | COMPLETED | FAILED
  status    String    @default("PENDING")
  /// Request variant configs: [{ name, userAgent, acceptLanguage, headers? }]
  variants  Json      @db.JsonB
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  responses ResearchResponse[]
  findings  CloakingFinding[]

  @@index([tenantId])
  @@index([status])
  @@map("research_tests")
}

/// Phase 4 Research Lab — one fetched response per request variant (additive).
/// Failed variants record their error in meta (never throw); they are excluded
/// from differential comparison.
model ResearchResponse {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  researchTestId String    @map("research_test_id") @db.Uuid
  variantName    String    @map("variant_name")
  httpStatus     Int?      @map("http_status")
  finalUrl       String?   @map("final_url")
  redirectChain  Json      @default("[]") @map("redirect_chain") @db.JsonB
  headers        Json      @default("{}") @db.JsonB
  htmlHash       String?   @map("html_hash")
  contentHash    String?   @map("content_hash")
  textExcerpt    String?   @map("text_excerpt")
  /// { error?: string, setCookieCount?: number, ... } — failure detail lives here
  meta           Json      @default("{}") @db.JsonB
  linksCount     Int?      @map("links_count")
  scriptsCount   Int?      @map("scripts_count")
  fetchedAt      DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  test   ResearchTest @relation(fields: [researchTestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([researchTestId])
  @@map("research_responses")
}

/// Phase 4 Research Lab — differential/cloaking finding per test run (additive).
/// differentialScore is a heuristic 0-100; 差异≠恶意 — see classifier.ts.
model CloakingFinding {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  researchTestId    String    @map("research_test_id") @db.Uuid
  offerId           String?   @map("offer_id") @db.Uuid
  /// Weighted differential score, 0-100 (see research/detector.ts)
  differentialScore Float     @map("differential_score")
  /// NORMAL | MINOR | SUSPICIOUS | HIGH_RISK | STRONG (score bands, §21)
  band              String
  /// One of the 8 classifier labels (see research/classifier.ts, §22)
  classification    String
  evidence          Json      @db.JsonB
  aiSummary         String?   @map("ai_summary")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  test   ResearchTest @relation(fields: [researchTestId], references: [id], onDelete: Cascade)
  offer  Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([researchTestId])
  @@index([offerId])
  @@map("cloaking_findings")
}

/// Lander Intel — landing page efficiency analysis (additive).
/// scores: { performance, cta, trust, mobile, copy, bounceRisk } 0-100 each.
/// issues: [{ dimension, severity: "high"|"medium"|"low", message }].
/// suggestions: [{ text, dataQuality: "PREDICTED" }] — always AI-generated.
model LanderAnalysis {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  url          String
  domain       String
  overallScore Float     @map("overall_score")
  scores       Json      @db.JsonB
  issues       Json      @db.JsonB
  suggestions  Json      @db.JsonB
  analyzedAt   DateTime  @default(now()) @map("analyzed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("lander_analyses")
}

/// Lander Intel — competitor landing page watch (additive).
/// checkInterval in seconds, minimum 3600 (1h) enforced in code.
model CompetitorWatch {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  url           String
  checkInterval Int       @default(3600) @map("check_interval")
  lastHash      String?   @map("last_hash")
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  changes CompetitorChange[]

  @@index([tenantId])
  @@map("competitor_watches")
}

/// Lander Intel — detected competitor page change (additive).
/// diffSummary: { title?: {before, after}, price?: {before, after},
///   cta?: {before, after}, sectionsAdded?: string[], sectionsRemoved?: string[] }
model CompetitorChange {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  watchId     String   @map("watch_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  diffSummary Json     @map("diff_summary") @db.JsonB

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  watch  CompetitorWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([watchId])
  @@map("competitor_changes")
}

/// Lander Intel — high-converting landing page templates (additive).
/// category: review | comparison | listicle | quiz.
/// tenantId NULL => built-in global template.
model LanderTemplate {
  id           String    @id @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  name         String
  category     String
  description  String?
  htmlTemplate String    @map("html_template")
  thumbnailUrl String?   @map("thumbnail_url")
  isBuiltIn    Boolean   @default(false) @map("is_built_in")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("lander_templates")
}

/// Automation — cashback-network offer (additive).
/// cashbackNetwork: e.g. "rakuten". trackingLinkId binds an offer to the
/// TrackingLink that currently serves it (nullable; SetNull on link delete).
model CashbackOffer {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  cashbackNetwork   String    @map("cashback_network")
  originalUrl       String    @map("original_url")
  trackingLinkId    String?   @map("tracking_link_id") @db.Uuid
  /// AdsPower browser-profile id for account isolation (opaque, no FK)
  adspowerProfileId String?   @map("adspower_profile_id")
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  trackingLink       TrackingLink?       @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)
  rotationGroupItems RotationGroupItem[]
  cashbackRateChecks CashbackRateCheck[]

  @@index([tenantId])
  @@index([trackingLinkId])
  @@index([status])
  @@map("cashback_offers")
}

/// Cashback automation pack (2026-10-08) — 返利比例监控：每次比例检查记录。
model CashbackRateCheck {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  cashbackOfferId String   @map("cashback_offer_id") @db.Uuid
  advertisedRate  String   @map("advertised_rate")
  detectedRate    String?  @map("detected_rate")
  rateUrl         String?  @map("rate_url")
  status          String
  checkedAt       DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashbackOffer CashbackOffer @relation(fields: [cashbackOfferId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([cashbackOfferId])
  @@index([checkedAt])
  @@map("cashback_rate_checks")
}

/// Cashback automation pack (2026-10-08) — 商家返利条款监控。
model CashbackTermsWatch {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  merchantName    String    @map("merchant_name")
  merchantDomain  String    @map("merchant_domain")
  termsUrl        String    @map("terms_url")
  termsHash       String?   @map("terms_hash")
  cashbackAllowed Boolean?  @map("cashback_allowed")
  lastChecked     DateTime? @map("last_checked") @db.Timestamptz(3)
  status          String    @default("ok")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("cashback_terms_watches")
}

/// Cashback automation pack (2026-10-08) — 跳转链检测：per-link redirect chain scan records.
model RedirectChainCheck {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  trackingLinkId String   @map("tracking_link_id") @db.Uuid
  hopCount       Int      @map("hop_count")
  hops           Json     @db.JsonB
  issues         Json     @db.JsonB
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)
  status         String

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackingLink TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)

  @@index([tenantId, trackingLinkId, checkedAt])
  @@map("redirect_chain_checks")
}

/// Cashback automation pack (2026-10-08) — 返利比价分组：一个 merchant 在多个返利网的 URL 集合。portals[0] 默认为主推。
model CashbackCompareGroup {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  merchantDomain String   @map("merchant_domain")
  portals        Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("cashback_compare_groups")
}

/// Cashback automation pack (2026-10-08) — 每次比价时每个 portal 的返利比例快照。
model CashbackRateSnapshot {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  merchantDomain String   @map("merchant_domain")
  portal         String
  rate           String?
  url            String?
  checkedAt      DateTime @map("checked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, merchantDomain, checkedAt(sort: Desc)])
  @@map("cashback_rate_snapshots")
}

/// Automation — offer rotation group (additive).
/// strategy: "round_robin" | "weighted" | ... (stored as plain string)
model RotationGroup {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  strategy  String   @default("round_robin")
  isActive  Boolean  @default(true) @map("is_active")
  /// Auto-rotation interval in milliseconds (default 1 hour). Null/0 = manual only.
  rotationIntervalMs Int @default(3600000) @map("rotation_interval_ms")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  items  RotationGroupItem[]

  @@index([tenantId])
  @@map("rotation_groups")
}

/// Automation — rotation group member (additive).
/// Deleting a group cascades to its items; offers are never cascade-deleted.
model RotationGroupItem {
  id              String @id @db.Uuid
  rotationGroupId String @map("rotation_group_id") @db.Uuid
  cashbackOfferId String @map("cashback_offer_id") @db.Uuid
  weight          Int    @default(1)
  sortOrder       Int    @default(0) @map("sort_order")

  rotationGroup RotationGroup @relation(fields: [rotationGroupId], references: [id], onDelete: Cascade)
  cashbackOffer CashbackOffer @relation(fields: [cashbackOfferId], references: [id], onDelete: Restrict)

  @@index([rotationGroupId])
  @@index([cashbackOfferId])
  @@map("rotation_group_items")
}

/// Automation Pack — 2026-10-07
/// 1. Dead link monitor: hourly health checks of ACTIVE tracking links.
model LinkHealthCheck {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  trackingLinkId String   @map("tracking_link_id") @db.Uuid
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)
  statusCode     Int?     @map("status_code")
  finalUrl       String?  @map("final_url")
  isAlive        Boolean  @map("is_alive")
  failureReason  String?  @map("failure_reason")
  responseTimeMs Int?     @map("response_time_ms")

  trackingLink TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)

  @@index([tenantId, trackingLinkId, checkedAt])
  @@map("link_health_checks")
}

/// 2. Search term miner: AI-suggested negative keywords from search term reports.
model SearchTermSuggestion {
  id              String                     @id @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  searchTerm      String                     @map("search_term")
  campaignName    String?                    @map("campaign_name")
  matchType       String?                    @map("match_type")
  suggestedAction SearchTermAction           @map("suggested_action")
  reason          String?
  status          SearchTermSuggestionStatus @default(PENDING)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, status])
  @@map("search_term_suggestions")
}

enum SearchTermAction {
  ADD_NEGATIVE_EXACT
  ADD_NEGATIVE_PHRASE
  IGNORE
}

enum SearchTermSuggestionStatus {
  PENDING
  APPLIED
  DISMISSED
}

/// 3. Payout watch: detect merchant commission changes.
model PayoutWatch {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  offerId       String    @map("offer_id") @db.Uuid
  enabled       Boolean   @default(true)
  lastPayout    Float?    @map("last_payout")
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  changeHistory Json      @default("[]") @map("change_history")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, offerId])
  @@index([tenantId])
  @@map("payout_watches")
}

/// 4. Budget pacer: ROAS-based auto budget adjustment rules.
model BudgetRule {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  googleAccountId   String    @map("google_account_id") @db.Uuid
  campaignName      String    @map("campaign_name")
  campaignId        String?   @map("campaign_id")
  targetRoas        Float     @map("target_roas")
  minDailyBudget    Float     @map("min_daily_budget")
  maxDailyBudget    Float     @map("max_daily_budget")
  increasePct       Float     @default(20) @map("increase_pct")
  decreasePct       Float     @default(20) @map("decrease_pct")
  checkIntervalDays Int       @default(7) @map("check_interval_days")
  enabled           Boolean   @default(false)
  lastEvaluatedAt   DateTime? @map("last_evaluated_at") @db.Timestamptz(3)
  lastAction        Json?     @map("last_action")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, enabled])
  @@map("budget_rules")
}

/// 5. Landing page optimization queue: tasks auto-created from analyzer scores.
model LandingPageOptimizationTask {
  id            String                 @id @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  landingPageId String                 @map("landing_page_id") @db.Uuid
  score         Int
  issues        Json                   @default("[]")
  priority      OptimizationPriority
  status        OptimizationTaskStatus @default(PENDING)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?              @map("completed_at") @db.Timestamptz(3)

  @@index([tenantId, status, priority])
  @@map("landing_page_optimization_tasks")
}

/// LP AI Rewriter (automation round 2): AI-generated before/after rewrite
/// drafts against analyzer issues; the user confirms in the UI before the
/// draft is applied to the LandingPage. Status is DRAFT/APPLIED (plain
/// String, not an enum, to keep the additive migration trivial).
model LandingPageRewrite {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  /// Nullable since task 4: template-sourced rewrite briefs have no source
  /// LandingPage yet (base HTML lives in rewritten_content.baseHtml).
  landingPageId    String?  @map("landing_page_id") @db.Uuid
  originalScore    Int      @map("original_score")
  issues           Json     @default("[]")
  rewrittenContent Json     @map("rewritten_content")
  newScore         Int?     @map("new_score")
  status           String   @default("DRAFT") @map("status")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, landingPageId])
  @@map("landing_page_rewrites")
}

enum OptimizationPriority {
  HIGH
  MEDIUM
  LOW
}

enum OptimizationTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

/// Launch Wizard (automation round 2): guided 6-step offer launch checklist.
/// Status is a plain String (DRAFT/IN_PROGRESS/COMPLETED) to keep the
/// additive migration trivial — same convention as LandingPageRewrite.
model LaunchChecklist {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  offerId        String?   @map("offer_id") @db.Uuid
  trackingLinkId String?   @map("tracking_link_id") @db.Uuid
  landingPageId  String?   @map("landing_page_id") @db.Uuid
  currentStep    Int       @default(1) @map("current_step")
  status         String    @default("DRAFT") @map("status")
  stepsData      Json      @default("{}") @map("steps_data")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  offer        Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  trackingLink TrackingLink? @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)
  landingPage  LandingPage?  @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([offerId])
  @@index([status])
  @@map("launch_checklists")
}

/// Automation round 2: weekly report — aggregated weekly stats + AI narrative
/// per tenant, generated every Monday 8am (America/New_York) by the
/// weekly-report worker, also manually triggerable via API.
model WeeklyReport {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  weekStart DateTime @map("week_start") @db.Timestamptz(3)
  weekEnd   DateTime @map("week_end") @db.Timestamptz(3)
  /// { spend, revenue, conversions, clicks, topOffers[], deadLinks,
  ///   newNegatives, newTasks, alerts } — spend is null when unavailable.
  data      Json     @db.JsonB
  aiSummary String   @map("ai_summary")
  /// GENERATED | SENT (plain String; email delivery not yet wired)
  status    String   @default("GENERATED")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, weekStart, weekEnd])
  @@index([tenantId])
  @@map("weekly_reports")
}

/// Offer 最终链接指标抓取 + 推荐指数（第三批）。
model OfferMetrics {
  id        String   @id @db.Uuid
  offerId   String   @unique @map("offer_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// 抓取到的指标 JSON（OfferMetrics 结构）。
  metrics   Json
  /// 推荐指数 0-100；无可用指标时为 null。
  score     Int?
  /// 等级：strong / good / caution / avoid。
  grade     String?
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("offer_metrics")
}

/// 选品流水线运行记录（第五批）：存每道门结果 JSON + 值得测试指数。
/// 否定清单（批次5追加）：用户维护的"别碰名单"，命中直接杀。
model DenylistEntry {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// asin | keyword | brand | category
  type      String   @db.VarChar(16)
  value     String   @db.VarChar(256)
  reason    String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type, value])
  @@index([tenantId])
  @@map("denylist_entries")
}

/// 组合测试（第九批）：一次测 5-10 个品的榜单页测试。
model ComboTestRun {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String   @db.VarChar(200)
  /// 渲染好的榜单 HTML（复用 builtin-listicle 模板）
  htmlContent   String?  @map("html_content")
  /// [{asin,title,brand,price,rating,reviewCount,offerId,trackingLinkId,publicId,clickUrl}]
  items         Json
  testDays      Int      @default(3) @map("test_days")
  targetClicks  Int      @default(200) @map("target_clicks")
  status        String   @default("running") @db.VarChar(16)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("combo_test_runs")
}

/// ASIN 跟踪（第十批）：用户一键跟踪的 ASIN。
/// 教练模式设置（第十三批）：每 tenant 一行；默认开启。
/// 手动录入累计花费（第十五批）：Campaign 模型无花费字段，花费走手动录入。
model ManualSpend {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  total     Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("manual_spend")
}

model CoachSetting {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  enabled          Boolean  @default(true)
  dailyBudgetLimit Float?   @map("daily_budget_limit")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("coach_settings")
}

model AsinWatch {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  asin      String   @db.VarChar(32)
  title     String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, asin])
  @@index([tenantId])
  @@map("asin_watches")
}

/// ASIN 快照（第十批）：每日快照 reviewCount/rating。
/// PA-API 实际返回无 BSR 字段（已查 amazon-adapter.ts：只有 CustomerReviews.Count/StarRating），
/// 用评论数增速做需求代理；原始响应当 JSON 存 rawJson。
model AsinSnapshot {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  asin        String   @db.VarChar(32)
  capturedAt  DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)
  reviewCount Int?     @map("review_count")
  rating      Float?
  price       Float?
  rawJson     Json?    @map("raw_json")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, asin, capturedAt])
  @@map("asin_snapshots")
}

/// 新手任务（第十二批）："7 天跑起来"任务流。
model OnboardTask {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  day       Int
  taskKey   String    @map("task_key") @db.VarChar(64)
  deepLink  String?   @map("deep_link") @db.VarChar(256)
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, taskKey])
  @@index([tenantId])
  @@map("onboard_tasks")
}

model ProductPipelineRun {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String?
  itemCount Int      @map("item_count")
  options   Json
  results   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("product_pipeline_runs")
}

model OfferCapture {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  url         String
  title       String?
  description String?
  price       Decimal? @db.Decimal
  currency    String?
  pageText    String   @map("page_text")
  source      String   @default("extension")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)], map: "offer_captures_tenant_created_idx")
  @@map("offer_captures")
}
