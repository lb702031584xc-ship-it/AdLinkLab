  confidence    Float
  sourceExcerpt String?   @map("source_excerpt")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  offerPolicy OfferPolicy @relation(fields: [offerPolicyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([offerPolicyId])
  @@index([rule])
  @@map("policy_evidence")
}

/// Phase 1 Offer Intelligence — structured risk score snapshot (§6/§10, additive).
model OfferRiskScore {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  offerId       String    @map("offer_id") @db.Uuid
  overallScore  Float     @map("overall_score")
  policyScore   Float?    @map("policy_score")
  profitScore   Float?    @map("profit_score")
  merchantScore Float?    @map("merchant_score")
  trackingScore Float?    @map("tracking_score")
  /// RUN | TEST | MANUAL_REVIEW | DO_NOT_RUN
  decision      String
  evaluatedAt   DateTime  @default(now()) @map("evaluated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([offerId])
  @@index([decision])
  @@map("offer_risk_scores")
