  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  offer    Offer            @relation(fields: [offerId], references: [id], onDelete: Restrict)
  evidence PolicyEvidence[]

  @@index([tenantId])
  @@index([offerId])
  @@map("offer_policies")
}

/// Phase 1 Offer Intelligence — per-rule evidence (§5, additive).
/// matchedText MUST come from the real fetched terms text — never invented by AI.
model PolicyEvidence {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  offerPolicyId String    @map("offer_policy_id") @db.Uuid
  rule          String
