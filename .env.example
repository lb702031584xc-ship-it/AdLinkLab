# AdLinkLab environment template (Phase 9.1)
# Copy to `.env` for docker compose / local production-like runs.
# NEVER commit real secrets. `.env` is gitignored.

# Docker Compose project name (required when the folder name is non-ASCII)
COMPOSE_PROJECT_NAME=adlinklab

# --- Core ---
NODE_ENV=development
API_PORT=3001

# --- CORS (Phase 10) ---
# Production: REQUIRED explicit comma-separated allowlist (fail closed; `*` forbidden)
# Dev/lab compose example:
CORS_ORIGINS=http://localhost:3000,http://localhost,http://web.localhost

# --- Rate limiting (Phase 10) ---
# RATE_LIMIT_API_MAX=120
# RATE_LIMIT_SCRIPT_MAX=60
# RATE_LIMIT_WINDOW=1 minute

# --- Traefik lab dashboard (Phase 10) ---
# Default off. Set true only for local lab dashboard on 127.0.0.1:8080
# TRAEFIK_DASHBOARD=true

# --- PostgreSQL (compose postgres service + Prisma) ---
POSTGRES_USER=adlinklab
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=adlinklab
# Host-side / local Prisma (localhost). For docker compose services use host `postgres`:
# DATABASE_URL=postgresql://adlinklab:replace-with-strong-password@postgres:5432/adlinklab?schema=public
DATABASE_URL=postgresql://adlinklab:replace-with-strong-password@localhost:5432/adlinklab?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
# Compose sets QUEUE_MODE=redis for api + worker. Local API without worker may use off.
# QUEUE_MODE=redis
# QUEUE_ENABLED=1

# --- Persistence (Phase 8.4.10-R1) ---
# Production: MUST be prisma + non-empty DATABASE_URL (fail closed; memory forbidden)
PERSISTENCE=prisma

# --- Tenant API Key auth (Phase 8.2 / 8.4.10-R1 / Phase 9.2) ---
# Production requires AUTH_MODE=api_key explicitly (disabled/missing/invalid → startup fail)
AUTH_MODE=api_key
# Format: key:tenantId,key2:tenantId2  (production never loads fixture keys)
ADLINKLAB_API_KEYS=replace-me-api-key:00000000-0000-4000-8000-000000000001
# ADLINKLAB_API_KEYS_NO_FIXTURES=1

# --- Script Integration Token pepper (Phase 8.4.2 — fail closed when missing outside test) ---
INTEGRATION_TOKEN_PEPPER=replace-me-integration-token-pepper-min-32-chars

# --- Providers (lab defaults) ---
GOOGLE_ADS_PROVIDER=mock
TRAFFIC_PROVIDER=database

# --- Script generator public API base (must not be localhost outside test) ---
# Example for Traefik lab: http://api.localhost
SCRIPT_API_BASE_URL=

# --- Web (Phase 8.4.7.2 / 8.4.9 / 9.1) ---
# Used by Server Components / Actions to reach API (compose default: http://api:3001)
# NEXT_PUBLIC_ prefix is required by existing web config helpers; tokens stay server-only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Server-only secrets — NEVER use NEXT_PUBLIC_* for these
ADLINKLAB_INTEGRATION_TOKEN=
ADLINKLAB_API_KEY=

# --- Worker ---
# Compose: service `worker` runs `node dist/worker.js`
# Local: pnpm --filter @adlinklab/api worker
#        pnpm --filter @adlinklab/api worker:start

# --- Migration ---
# Compose: one-shot service `migrate` runs:
#   pnpm --filter @adlinklab/database migrate:deploy
# Local: pnpm --filter @adlinklab/database migrate:deploy
# Do NOT use prisma db push for production deployment.

# --- Phase 9.4 PostgreSQL backup / recovery ---
# Local backup directory (gitignored). Never commit dumps.
# ADLINKLAB_BACKUP_DIR=./backups
# Optional: directory containing pg_dump / pg_restore binaries
# ADLINKLAB_PG_BIN=
# Isolated restore target (MUST differ from DATABASE_URL). Never restore onto production.
# ADLINKLAB_BACKUP_RESTORE_DATABASE_URL=postgresql://adlinklab:replace-with-strong-password@localhost:5432/adlinklab_restore_verify
# ADLINKLAB_BACKUP_ALLOW_RESTORE=1
# ADLINKLAB_BACKUP_KEEP=5
# ADLINKLAB_BACKUP_PRODUCTION_DATABASE=adlinklab
# Note: pg_dump/pg_restore reject Prisma `?schema=public`; backup CLI strips it automatically.
