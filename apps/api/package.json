{
  "name": "@adlinklab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adlinklab/conversions": "workspace:*",
    "@adlinklab/database": "workspace:*",
    "@adlinklab/domain": "workspace:*",
    "@adlinklab/google-ads": "workspace:*",
    "@adlinklab/offers": "workspace:*",
    "@adlinklab/shared": "workspace:*",
    "@adlinklab/tracking": "workspace:*",
    "@adlinklab/traffic": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.0.1",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
