{
  "name": "adlinklab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AdLinkLab — research SaaS for Google Ads tracking, attribution, and URL experimentation",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @adlinklab/database generate",
    "db:migrate": "pnpm --filter @adlinklab/database migrate",
    "db:migrate:deploy": "pnpm --filter @adlinklab/database migrate:deploy",
    "db:push": "pnpm --filter @adlinklab/database push",
    "backup:create": "pnpm --filter @adlinklab/database backup:create",
    "backup:verify": "pnpm --filter @adlinklab/database backup:verify",
    "backup:restore-test": "pnpm --filter @adlinklab/database backup:restore-test",
    "backup:cleanup": "pnpm --filter @adlinklab/database backup:cleanup"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.1",
    "globals": "^15.14.0"
  }
}
